---
import { env } from "cloudflare:workers";
import { and, asc, desc, eq, sql } from "drizzle-orm";
import PostCard from "@/components/PostCard.astro";
import { blogCategories, blogPosts } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";
import { estimateArticleReadStats, formatDate } from "@/lib/format";
import { getPublicPostVisibilityCondition } from "@/lib/public-content";
import { encodeRouteParam } from "@/lib/security";
import {
	buildHeroActionLinks,
	DEFAULT_SITE_APPEARANCE,
	getSiteAppearance,
	resolveSiteDescriptionFromAppearance,
} from "@/lib/site-appearance";
import { siteConfig } from "@/lib/types";

interface HomePostCardRow {
	title: string;
	slug: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
	cjkCharCount: number;
	latinWordCount: number;
	estimatedReadingMinutes: number;
}

let pinnedPosts: HomePostCardRow[] = [];
let recentPosts: HomePostCardRow[] = [];
let totalPublishedPosts = 0;
let homepageAppearance = DEFAULT_SITE_APPEARANCE;

function toHomePostCardRow(row: {
	title: string;
	slug: string;
	content: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
}): HomePostCardRow {
	const readingStats = estimateArticleReadStats(row.content);

	return {
		title: row.title,
		slug: row.slug,
		excerpt: row.excerpt,
		publishedAt: row.publishedAt,
		authorName: row.authorName,
		categoryName: row.categoryName,
		featuredImageKey: row.featuredImageKey,
		featuredImageAlt: row.featuredImageAlt,
		cjkCharCount: readingStats.cjkCharCount,
		latinWordCount: readingStats.latinWordCount,
		estimatedReadingMinutes: readingStats.estimatedReadingMinutes,
	};
}

try {
	const db = getDb(env.DB);
	const [appearanceResult, countRows, pinnedRows, recentRows] =
		await Promise.all([
			getSiteAppearance(db),
			db
				.select({ count: sql<number>`count(*)` })
				.from(blogPosts)
				.where(getPublicPostVisibilityCondition()),
			db
				.select({
					title: blogPosts.title,
					slug: blogPosts.slug,
					content: blogPosts.content,
					excerpt: blogPosts.excerpt,
					publishedAt: blogPosts.publishedAt,
					authorName: blogPosts.authorName,
					categoryName: blogCategories.name,
					featuredImageKey: blogPosts.featuredImageKey,
					featuredImageAlt: blogPosts.featuredImageAlt,
				})
				.from(blogPosts)
				.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
				.where(
					and(getPublicPostVisibilityCondition(), eq(blogPosts.isPinned, true)),
				)
				.orderBy(
					asc(blogPosts.pinnedOrder),
					desc(blogPosts.publishedAt),
					desc(blogPosts.createdAt),
				)
				.limit(5),
			db
				.select({
					title: blogPosts.title,
					slug: blogPosts.slug,
					content: blogPosts.content,
					excerpt: blogPosts.excerpt,
					publishedAt: blogPosts.publishedAt,
					authorName: blogPosts.authorName,
					categoryName: blogCategories.name,
					featuredImageKey: blogPosts.featuredImageKey,
					featuredImageAlt: blogPosts.featuredImageAlt,
				})
				.from(blogPosts)
				.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
				.where(
					and(
						getPublicPostVisibilityCondition(),
						eq(blogPosts.isPinned, false),
					),
				)
				.orderBy(desc(blogPosts.publishedAt), desc(blogPosts.createdAt))
				.limit(5),
		]);

	homepageAppearance = appearanceResult;
	totalPublishedPosts = countRows[0]?.count ?? 0;
	pinnedPosts = pinnedRows.map(toHomePostCardRow);
	recentPosts = recentRows.map(toHomePostCardRow);
} catch {
	// D1 未绑定时首页退化为空列表
}

const latestPost = [...pinnedPosts, ...recentPosts]
	.filter((post) => Boolean(post.publishedAt))
	.sort(
		(a, b) =>
			new Date(b.publishedAt ?? 0).getTime() -
			new Date(a.publishedAt ?? 0).getTime(),
	)[0];
const latestUpdateAt = latestPost?.publishedAt || null;
const latestUpdate = latestUpdateAt
	? formatDate(latestUpdateAt)
	: "尚无已发布文章";
const recentSectionSubheading =
	pinnedPosts.length > 0 ? "" : "按时间倒序收录近期工程思考与调试手记。";
const heroActions = buildHeroActionLinks(homepageAppearance);
const signalChips = [
	homepageAppearance.heroSignalChip1,
	homepageAppearance.heroSignalChip2,
	homepageAppearance.heroSignalChip3,
]
	.map((chip) => chip?.trim())
	.filter(Boolean);
const hasSignalImage = Boolean(homepageAppearance.heroSignalImagePath);
const homepageMetaDescription = resolveSiteDescriptionFromAppearance(
	homepageAppearance,
	siteConfig.description,
);

function isInternalHref(href: string) {
	return href.startsWith("/") && !href.startsWith("//");
}
---

<Base title={siteConfig.name} description={homepageMetaDescription}>
	<!-- 非对称双舱 Bento 首屏：左舱「画廊插画视窗 + 个人刊头宣言 + 全部自定义动作」，右舱「画集级立绘人设名片 + 实时最近更新直达条」 -->
	<section class="home-bento-stage" data-hero-depth>
		<div
			class="hero-masthead-deck home-hero-copy glass-panel"
			data-tilt-card
			data-tilt-scale="0.44"
			data-tilt-shift-scale="0.76"
		>
			{
				homepageAppearance.heroMainImagePath && (
					<div class="hero-main-media">
						<img
							src={homepageAppearance.heroMainImagePath}
							alt=""
							loading="eager"
							decoding="async"
						/>
					</div>
				)
			}

			<div class="masthead-content">
				<div class="masthead-topline">
					<span class="masthead-live-badge">
						<span class="masthead-live-dot" aria-hidden="true"></span>
						<span>{homepageAppearance.heroKicker}</span>
					</span>
					<span class="masthead-telemetry">
						ISSUE.{String(Math.max(totalPublishedPosts, 1)).padStart(2, "0")} · {totalPublishedPosts} 篇公开记录
					</span>
				</div>

				<div class="masthead-body">
					<h1 class="page-title">{homepageAppearance.heroTitle}</h1>
					<p class="page-intro">{homepageAppearance.heroIntro}</p>
				</div>

				<div class="masthead-controls">
					{
						heroActions.map((action, index) => {
							const btn = (
								<a
									href={action.href}
									class:list={[
										"button",
										index === 0 ? "masthead-primary-btn" : "button-secondary",
									]}
									target={isInternalHref(action.href) ? undefined : "_blank"}
									rel={
										isInternalHref(action.href)
											? undefined
											: "noopener noreferrer"
									}
								>
									<span>{action.label}</span>
									{index === 0 && <span aria-hidden="true">→</span>}
								</a>
							);

							return index === 1 ? (
								<span class="hero-search-bridge" transition:name="search-entry">
									{btn}
								</span>
							) : (
								btn
							);
						})
					}

					<button
						type="button"
						class="masthead-spotlight-bar"
						data-command-trigger
						aria-label="打开全站即时检索命令舱"
					>
						<svg
							width="14"
							height="14"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="11" cy="11" r="8"></circle>
							<path d="m21 21-4.3-4.3"></path>
						</svg>
						<span class="masthead-spotlight-placeholder">快速检索...</span>
						<kbd>⌘K</kbd>
					</button>
				</div>
			</div>
		</div>

		<div class="home-hero-side">
			<article
				class:list={[
					"hero-signal-card",
					"glass-panel",
					{ "hero-signal-card-has-image": hasSignalImage },
				]}
				data-tilt-card
				data-tilt-scale="0.56"
				data-tilt-shift-scale="0.9"
			>
				{
					homepageAppearance.heroSignalImagePath && (
						<div class="hero-signal-media" aria-hidden="true">
							<img
								src={homepageAppearance.heroSignalImagePath}
								alt=""
								loading="eager"
								decoding="async"
							/>
						</div>
					)
				}

				<div class="hero-signal-content">
					{
						homepageAppearance.heroSignalLabel && (
							<span class="hero-signal-label">
								<span class="hero-signal-spark" aria-hidden="true">✦</span>
								<span>{homepageAppearance.heroSignalLabel}</span>
							</span>
						)
					}
					<strong class="hero-signal-heading">
						{homepageAppearance.heroSignalHeading}
					</strong>
					{
						homepageAppearance.heroSignalCopy && (
							<p class="hero-signal-copy">{homepageAppearance.heroSignalCopy}</p>
						)
					}
					{
						signalChips.length > 0 && (
							<div class="hero-signal-row">
								{signalChips.map((chip) => (
									<span class="hero-signal-chip">{chip}</span>
								))}
							</div>
						)
					}
				</div>
			</article>

			<aside
				class="hero-dispatch glass-panel"
				data-tilt-card
				data-tilt-scale="0.42"
				data-tilt-shift-scale="0.68"
				aria-label="最近更新"
			>
				{
					latestPost ? (
						<a
							href={`/blog/${encodeRouteParam(latestPost.slug)}`}
							class="dispatch-compact-link"
							data-astro-prefetch="hover"
						>
							<div class="dispatch-compact-main">
								<div class="dispatch-compact-meta">
									<span class="dispatch-stamp">最近更新</span>
									{latestUpdateAt ? (
										<time
											class="dispatch-date local-time-pending"
											datetime={latestUpdateAt}
											data-local-time="date"
										>
											{latestUpdate}
										</time>
									) : (
										<span class="dispatch-date">{latestUpdate}</span>
									)}
								</div>
								<strong class="dispatch-compact-title">{latestPost.title}</strong>
							</div>
							<span class="dispatch-orb" aria-hidden="true">↗</span>
						</a>
					) : (
						<div class="dispatch-compact-empty">
							<span class="dispatch-stamp">最近更新</span>
							<strong>{latestUpdate}</strong>
						</div>
					)
				}
			</aside>
		</div>
	</section>

	{
		pinnedPosts.length > 0 && (
			<section class="home-section" aria-labelledby="pinned-heading">
				<div class="section-head">
					<div class="section-head-main">
						<span class="section-kicker">置顶文章</span>
						<h2 id="pinned-heading" class="section-heading">精选特辑</h2>
					</div>
					<span class="section-index-code" aria-hidden="true">
						PINNED // {String(pinnedPosts.length).padStart(2, "0")}
					</span>
				</div>

				<div class="home-grid home-grid-pinned">
					{pinnedPosts.map((post, index) => (
						<PostCard
							title={post.title}
							slug={post.slug}
							excerpt={post.excerpt}
							publishedAt={post.publishedAt}
							authorName={post.authorName}
							categoryName={post.categoryName}
							featuredImageKey={post.featuredImageKey}
							featuredImageAlt={post.featuredImageAlt}
							cjkCharCount={post.cjkCharCount}
							latinWordCount={post.latinWordCount}
							estimatedReadingMinutes={post.estimatedReadingMinutes}
							variant={index === 0 ? "featured" : "regular"}
							indexNumber={index + 1}
						/>
					))}
				</div>
			</section>
		)
	}

	<section class="home-section" aria-labelledby="recent-heading">
		<div class="section-head">
			<div class="section-head-main">
				<span class="section-kicker">最近更新</span>
				<h2 id="recent-heading" class="section-heading">近期刊发</h2>
				{recentSectionSubheading && (
					<p class="section-subheading">{recentSectionSubheading}</p>
				)}
			</div>
			<a href="/blog" class="section-more-link">
				<span>进入编年史归档</span>
				<span aria-hidden="true">→</span>
			</a>
		</div>

		{recentPosts.length > 0 ? (
			<div class="home-grid">
				{recentPosts.map((post, index) => (
					<PostCard
						title={post.title}
						slug={post.slug}
						excerpt={post.excerpt}
						publishedAt={post.publishedAt}
						authorName={post.authorName}
						categoryName={post.categoryName}
						featuredImageKey={post.featuredImageKey}
						featuredImageAlt={post.featuredImageAlt}
						cjkCharCount={post.cjkCharCount}
						latinWordCount={post.latinWordCount}
						estimatedReadingMinutes={post.estimatedReadingMinutes}
						variant={
							pinnedPosts.length === 0 && index === 0 ? "featured" : "regular"
						}
						indexNumber={pinnedPosts.length + index + 1}
					/>
				))}
			</div>
		) : (
			<div class="empty-state glass-panel">
				<p>还没有公开文章，先去后台发布第一篇内容。</p>
			</div>
		)}
	</section>
</Base>

<style>
	.home-bento-stage {
		--hero-pointer-x: 0;
		--hero-pointer-y: 0;
		--hero-scroll-shift: 0px;
		display: grid;
		grid-template-columns: minmax(0, 1.38fr) minmax(19.5rem, 0.92fr);
		align-items: stretch;
		gap: 1.15rem;
		animation: stage-enter 540ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-masthead-deck,
	.hero-signal-card,
	.hero-dispatch {
		--glass-panel-opacity: calc(var(--hero-card-opacity, 14) / 100);
		--glass-panel-blur: var(--hero-card-blur, 18px);
		transform: perspective(1280px) rotateX(var(--tilt-rotate-x, 0deg))
			rotateY(var(--tilt-rotate-y, 0deg));
		transition:
			transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
			border-color var(--transition),
			box-shadow var(--transition);
	}

	/* 左舱：画廊主图视窗 + 刊头宣言 */
	.hero-masthead-deck {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.45rem;
		padding: clamp(1.35rem, 1.05rem + 1.6vw, 2rem);
	}

	.hero-main-media {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border-strong);
		min-height: clamp(11.5rem, 23vh, 15.8rem);
		aspect-ratio: 16 / 8.2;
		background: var(--color-bg-tertiary);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.24),
			0 16px 36px -24px var(--color-shadow-strong);
	}

	.hero-main-media::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22);
		pointer-events: none;
	}

	.hero-main-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transform: translate3d(
				calc(var(--tilt-shift-x, 0) * 6px),
				calc(var(--tilt-shift-y, 0) * 6px),
				0
			)
			scale(1.035);
		transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.masthead-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.35rem;
		padding-inline: 0.2rem;
	}

	.masthead-topline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem 1rem;
		padding-bottom: 0.85rem;
		border-bottom: 1px solid var(--color-border);
	}

	.masthead-live-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--color-accent);
	}

	.masthead-live-dot {
		width: 7px;
		height: 7px;
		flex-shrink: 0;
		border-radius: 50%;
		background: #10b981;
		box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18);
		animation: live-pulse 2.6s ease-in-out infinite;
	}

	@keyframes live-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.16);
		}
		50% {
			box-shadow: 0 0 0 6px rgba(16, 185, 129, 0.04);
		}
	}

	.masthead-telemetry {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.masthead-body {
		display: grid;
		gap: 0.95rem;
	}

	.home-hero-copy .page-title {
		max-width: 16ch;
		font-size: clamp(2.15rem, 1.65rem + 2.15vw, 3.35rem);
		font-weight: 780;
		line-height: 1.14;
		letter-spacing: -0.032em;
	}

	.home-hero-copy .page-intro {
		white-space: pre-line;
		max-width: 40rem;
		font-size: clamp(0.95rem, 0.91rem + 0.18vw, 1.04rem);
		line-height: 1.78;
		color: var(--color-text-secondary);
	}

	.masthead-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
		padding-top: 0.2rem;
	}

	.masthead-primary-btn {
		height: 2.68rem;
		padding-inline: 1.2rem;
	}

	.masthead-controls .button-secondary {
		height: 2.68rem;
		padding-inline: 1.05rem;
	}

	.hero-search-bridge {
		display: inline-flex;
	}

	.masthead-spotlight-bar {
		margin-left: auto;
		height: 2.68rem;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0 0.62rem 0 0.85rem;
		border-radius: var(--radius-pill);
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border-strong);
		color: var(--color-text-muted);
		font-size: 0.84rem;
		box-shadow: inset 0 1px 0 var(--glass-highlight);
		cursor: pointer;
		transition:
			border-color var(--transition),
			background-color var(--transition),
			color var(--transition),
			transform 120ms ease-out;
	}

	.masthead-spotlight-bar:hover {
		color: var(--color-text);
		border-color: rgba(var(--color-accent-rgb), 0.38);
		background: var(--color-accent-soft);
	}

	.masthead-spotlight-bar:active {
		transform: scale(0.98);
	}

	.masthead-spotlight-placeholder {
		white-space: nowrap;
	}

	.masthead-spotlight-bar kbd {
		flex-shrink: 0;
		padding: 0.15rem 0.42rem;
		border-radius: 999px;
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		color: var(--color-text-secondary);
	}

	/* 右舱：立绘人设名片舱 + 底部最近更新直达条 */
	.home-hero-side {
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		gap: 1.05rem;
		min-width: 0;
	}

	.hero-signal-card {
		position: relative;
		min-height: 24.5rem;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}

	.hero-signal-media {
		position: absolute;
		inset: 0;
		z-index: 2;
		overflow: hidden;
		border-radius: inherit;
	}

	/* 主题自适应底部羽化层：既保留透明通道立绘背后的通透毛玻璃，又柔化裙摆与下方悬浮铭牌的交界 */
	.hero-signal-media::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(var(--card-surface-rgb), 0) 0%,
			rgba(var(--card-surface-rgb), 0.04) 48%,
			rgba(var(--card-surface-rgb), 0.56) 82%,
			rgba(var(--card-surface-rgb), 0.82) 100%
		);
		pointer-events: none;
	}

	.hero-signal-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 6%;
		transform: translate3d(
				calc(var(--tilt-shift-x, 0) * -5px),
				calc(var(--tilt-shift-y, 0) * -5px),
				0
			)
			scale(1.02);
		transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.hero-signal-content {
		position: relative;
		z-index: 3;
		display: grid;
		gap: 0.65rem;
		padding: 1.35rem 1.4rem;
	}

	.hero-signal-card-has-image .hero-signal-content {
		margin: 0.65rem;
		padding: 1.05rem 1.15rem;
		border-radius: var(--radius-card);
		border: 1px solid var(--glass-border);
		background: rgba(var(--card-surface-rgb), 0.68);
		box-shadow:
			inset 0 1px 0 var(--glass-highlight),
			0 12px 28px -18px var(--color-shadow-strong);
		backdrop-filter: blur(min(calc(var(--hero-card-blur, 18px) * 1.25), 36px))
			saturate(150%);
		-webkit-backdrop-filter: blur(
				min(calc(var(--hero-card-blur, 18px) * 1.25), 36px)
			)
