---
import { env } from "cloudflare:workers";
import { and, asc, desc, eq, sql } from "drizzle-orm";
import PostCard from "@/components/PostCard.astro";
import { blogCategories, blogPosts } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";
import { estimateArticleReadStats, formatDate } from "@/lib/format";
import { getPublicPostVisibilityCondition } from "@/lib/public-content";
import { encodeRouteParam } from "@/lib/security";
import {
	buildHeroActionLinks,
	DEFAULT_SITE_APPEARANCE,
	getSiteAppearance,
	resolveSiteDescriptionFromAppearance,
} from "@/lib/site-appearance";
import { siteConfig } from "@/lib/types";

interface HomePostCardRow {
	title: string;
	slug: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
	cjkCharCount: number;
	latinWordCount: number;
	estimatedReadingMinutes: number;
}

let pinnedPosts: HomePostCardRow[] = [];
let recentPosts: HomePostCardRow[] = [];
let totalPublishedPosts = 0;
let homepageAppearance = DEFAULT_SITE_APPEARANCE;

function toHomePostCardRow(row: {
	title: string;
	slug: string;
	content: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
}): HomePostCardRow {
	const readingStats = estimateArticleReadStats(row.content);

	return {
		title: row.title,
		slug: row.slug,
		excerpt: row.excerpt,
		publishedAt: row.publishedAt,
		authorName: row.authorName,
		categoryName: row.categoryName,
		featuredImageKey: row.featuredImageKey,
		featuredImageAlt: row.featuredImageAlt,
		cjkCharCount: readingStats.cjkCharCount,
		latinWordCount: readingStats.latinWordCount,
		estimatedReadingMinutes: readingStats.estimatedReadingMinutes,
	};
}

try {
	const db = getDb(env.DB);
	const [appearanceResult, countRows, pinnedRows, recentRows] =
		await Promise.all([
			getSiteAppearance(db),
			db
				.select({ count: sql<number>`count(*)` })
				.from(blogPosts)
				.where(getPublicPostVisibilityCondition()),
			db
				.select({
					title: blogPosts.title,
					slug: blogPosts.slug,
					content: blogPosts.content,
					excerpt: blogPosts.excerpt,
					publishedAt: blogPosts.publishedAt,
					authorName: blogPosts.authorName,
					categoryName: blogCategories.name,
					featuredImageKey: blogPosts.featuredImageKey,
					featuredImageAlt: blogPosts.featuredImageAlt,
				})
				.from(blogPosts)
				.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
				.where(
					and(getPublicPostVisibilityCondition(), eq(blogPosts.isPinned, true)),
				)
				.orderBy(
					asc(blogPosts.pinnedOrder),
					desc(blogPosts.publishedAt),
					desc(blogPosts.createdAt),
				)
				.limit(5),
			db
				.select({
					title: blogPosts.title,
					slug: blogPosts.slug,
					content: blogPosts.content,
					excerpt: blogPosts.excerpt,
					publishedAt: blogPosts.publishedAt,
					authorName: blogPosts.authorName,
					categoryName: blogCategories.name,
					featuredImageKey: blogPosts.featuredImageKey,
					featuredImageAlt: blogPosts.featuredImageAlt,
				})
				.from(blogPosts)
				.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
				.where(
					and(
						getPublicPostVisibilityCondition(),
						eq(blogPosts.isPinned, false),
					),
				)
				.orderBy(desc(blogPosts.publishedAt), desc(blogPosts.createdAt))
				.limit(5),
		]);

	homepageAppearance = appearanceResult;
	totalPublishedPosts = countRows[0]?.count ?? 0;
	pinnedPosts = pinnedRows.map(toHomePostCardRow);
	recentPosts = recentRows.map(toHomePostCardRow);
} catch {
	// D1 未绑定时首页退化为空列表
}

const latestPost = [...pinnedPosts, ...recentPosts]
	.filter((post) => Boolean(post.publishedAt))
	.sort(
		(a, b) =>
			new Date(b.publishedAt ?? 0).getTime() -
			new Date(a.publishedAt ?? 0).getTime(),
	)[0];
const latestUpdateAt = latestPost?.publishedAt || null;
const latestUpdate = latestUpdateAt
	? formatDate(latestUpdateAt)
	: "尚无已发布文章";
const recentSectionSubheading =
	pinnedPosts.length > 0 ? "" : "按时间倒序收录近期工程思考与调试手记。";
const heroActions = buildHeroActionLinks(homepageAppearance);
const primaryAction = heroActions[0] ?? { label: "浏览归档", href: "/blog" };
const extraActions = heroActions.slice(2);
const homepageMetaDescription = resolveSiteDescriptionFromAppearance(
	homepageAppearance,
	siteConfig.description,
);

function isInternalHref(href: string) {
	return href.startsWith("/") && !href.startsWith("//");
}
---

<Base title={siteConfig.name} description={homepageMetaDescription}>
	<!-- 非对称双舱 Bento 舞台：左舱主刊头 + 即时 Spotlight 检索条，右舱独立当期特写封面卡 -->
	<section class="home-bento-stage" data-hero-depth>
		<div
			class="hero-masthead-deck home-hero-copy glass-panel"
			data-tilt-card
			data-tilt-scale="0.48"
			data-tilt-shift-scale="0.78"
		>
			<div class="masthead-topline">
				<span class="masthead-live-badge">
					<span class="masthead-live-dot" aria-hidden="true"></span>
					<span>{homepageAppearance.heroKicker}</span>
				</span>
				<span class="masthead-telemetry">
					ISSUE.{String(Math.max(totalPublishedPosts, 1)).padStart(2, "0")} · {totalPublishedPosts} 篇公开记录
				</span>
			</div>

			<div class="masthead-body">
				<h1 class="page-title">{homepageAppearance.heroTitle}</h1>
				<p class="page-intro">{homepageAppearance.heroIntro}</p>
			</div>

			<div class="masthead-controls">
				<a
					href={primaryAction.href}
					class="button masthead-primary-btn"
					target={isInternalHref(primaryAction.href) ? undefined : "_blank"}
					rel={isInternalHref(primaryAction.href) ? undefined : "noopener noreferrer"}
				>
					<span>{primaryAction.label}</span>
					<span aria-hidden="true">→</span>
				</a>

				<span class="hero-search-bridge" transition:name="search-entry">
					<a
						href="/search"
						class="masthead-spotlight-bar"
						data-command-trigger
						aria-label="打开全站即时检索命令舱"
					>
						<svg
							width="15"
							height="15"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="11" cy="11" r="8"></circle>
							<path d="m21 21-4.3-4.3"></path>
						</svg>
						<span class="masthead-spotlight-placeholder">检索文章或输入指令...</span>
						<kbd>⌘K</kbd>
					</a>
				</span>

				{extraActions.map((action) => (
					<a
						href={action.href}
						class="button button-secondary"
						target={isInternalHref(action.href) ? undefined : "_blank"}
						rel={isInternalHref(action.href) ? undefined : "noopener noreferrer"}
					>
						{action.label}
					</a>
				))}
			</div>
		</div>

		<aside
			class="hero-dispatch glass-panel"
			data-tilt-card
			data-tilt-scale="0.56"
			data-tilt-shift-scale="0.88"
			aria-label="当期最新特写"
		>
			<div class="dispatch-ribbon">
				<span class="dispatch-stamp">LATEST DISPATCH</span>
				{
					latestUpdateAt ? (
						<time
							class="dispatch-date local-time-pending"
							datetime={latestUpdateAt}
							data-local-time="date"
						>
							{latestUpdate}
						</time>
					) : (
						<span class="dispatch-date">{latestUpdate}</span>
					)
				}
			</div>

			{
				homepageAppearance.heroMainImagePath && (
					<div class="hero-main-media">
						<img
							src={homepageAppearance.heroMainImagePath}
							alt=""
							loading="eager"
							decoding="async"
						/>
					</div>
				)
			}

			{
				latestPost ? (
					<a
						href={`/blog/${encodeRouteParam(latestPost.slug)}`}
						class="dispatch-story"
						data-astro-prefetch="hover"
					>
						<div class="dispatch-story-body">
							{latestPost.categoryName && (
								<span class="dispatch-category">{latestPost.categoryName}</span>
							)}
							<h2 class="dispatch-title">{latestPost.title}</h2>
							{latestPost.excerpt && (
								<p class="dispatch-excerpt">{latestPost.excerpt}</p>
							)}
						</div>
						<div class="dispatch-footer">
							<span class="dispatch-readtime">
								约 {latestPost.estimatedReadingMinutes} 分钟 · 立即阅读
							</span>
							<span class="dispatch-orb" aria-hidden="true">↗</span>
						</div>
					</a>
				) : (
					<div class="dispatch-empty">
						<strong>等待第一篇刊发</strong>
						<p>围绕 Cloudflare、边缘计算、前端动效与系统架构的技术手帐已就绪。</p>
					</div>
				)
			}
		</aside>
	</section>

	{
		pinnedPosts.length > 0 && (
			<section class="home-section" aria-labelledby="pinned-heading">
				<div class="section-head">
					<div class="section-head-main">
						<span class="section-kicker">置顶文章</span>
						<h2 id="pinned-heading" class="section-heading">精选特辑</h2>
					</div>
					<span class="section-index-code" aria-hidden="true">
						PINNED // {String(pinnedPosts.length).padStart(2, "0")}
					</span>
				</div>

				<div class="home-grid home-grid-pinned">
					{pinnedPosts.map((post, index) => (
						<PostCard
							title={post.title}
							slug={post.slug}
							excerpt={post.excerpt}
							publishedAt={post.publishedAt}
							authorName={post.authorName}
							categoryName={post.categoryName}
							featuredImageKey={post.featuredImageKey}
							featuredImageAlt={post.featuredImageAlt}
							cjkCharCount={post.cjkCharCount}
							latinWordCount={post.latinWordCount}
							estimatedReadingMinutes={post.estimatedReadingMinutes}
							variant={index === 0 ? "featured" : "regular"}
							indexNumber={index + 1}
						/>
					))}
				</div>
			</section>
		)
	}

	<section class="home-section" aria-labelledby="recent-heading">
		<div class="section-head">
			<div class="section-head-main">
				<span class="section-kicker">最近更新</span>
				<h2 id="recent-heading" class="section-heading">近期刊发</h2>
				{recentSectionSubheading && (
					<p class="section-subheading">{recentSectionSubheading}</p>
				)}
			</div>
			<a href="/blog" class="section-more-link">
				<span>进入编年史归档</span>
				<span aria-hidden="true">→</span>
			</a>
		</div>

		{recentPosts.length > 0 ? (
			<div class="home-grid">
				{recentPosts.map((post, index) => (
					<PostCard
						title={post.title}
						slug={post.slug}
						excerpt={post.excerpt}
						publishedAt={post.publishedAt}
						authorName={post.authorName}
						categoryName={post.categoryName}
						featuredImageKey={post.featuredImageKey}
						featuredImageAlt={post.featuredImageAlt}
						cjkCharCount={post.cjkCharCount}
						latinWordCount={post.latinWordCount}
						estimatedReadingMinutes={post.estimatedReadingMinutes}
						variant={pinnedPosts.length === 0 && index === 0 ? "featured" : "regular"}
						indexNumber={pinnedPosts.length + index + 1}
					/>
				))}
			</div>
		) : (
			<div class="empty-state glass-panel">
				<p>还没有公开文章，先去后台发布第一篇内容。</p>
			</div>
		)}
	</section>
</Base>

<style>
	.home-bento-stage {
		--hero-pointer-x: 0;
		--hero-pointer-y: 0;
		--hero-scroll-shift: 0px;
		display: grid;
		grid-template-columns: minmax(0, 1.38fr) minmax(19rem, 0.92fr);
		align-items: stretch;
		gap: 1.15rem;
		animation: stage-enter 540ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-masthead-deck,
	.hero-dispatch {
		--glass-panel-opacity: calc(var(--hero-card-opacity, 14) / 100);
		--glass-panel-blur: var(--hero-card-blur, 18px);
		transform:
			perspective(1280px)
			rotateX(var(--tilt-rotate-x, 0deg))
			rotateY(var(--tilt-rotate-y, 0deg));
		transition:
			transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
			border-color var(--transition),
			box-shadow var(--transition);
	}

	.hero-masthead-deck {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.8rem;
		padding: clamp(1.65rem, 1.25rem + 2.2vw, 2.75rem);
	}

	.masthead-topline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem 1rem;
		padding-bottom: 0.95rem;
		border-bottom: 1px solid var(--color-border);
	}

	.masthead-live-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.48rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.masthead-live-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #10b981;
		box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18);
		animation: live-pulse 2.6s ease-in-out infinite;
	}

	@keyframes live-pulse {
		0%, 100% { box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.16); }
		50% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0.04); }
	}

	.masthead-telemetry {
		font-family: var(--font-mono);
		font-size: 0.73rem;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.masthead-body {
		display: grid;
		gap: 1.05rem;
	}

	.home-hero-copy .page-title {
		max-width: 15.5ch;
		font-size: clamp(2.15rem, 1.65rem + 2.2vw, 3.4rem);
		font-weight: 780;
		line-height: 1.13;
		letter-spacing: -0.034em;
	}

	.home-hero-copy .page-intro {
		white-space: pre-line;
		max-width: 38rem;
		font-size: clamp(0.96rem, 0.92rem + 0.2vw, 1.06rem);
		color: var(--color-text-secondary);
	}

	.masthead-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem;
	}

	.masthead-primary-btn {
		height: 2.75rem;
		padding-inline: 1.25rem;
	}

	.hero-search-bridge {
		flex: 1 1 13.5rem;
		max-width: 20rem;
		display: flex;
	}

	/* 仿真 Spotlight 搜索条：一键呼出全站实时命令面板 */
	.masthead-spotlight-bar {
		width: 100%;
		height: 2.75rem;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0 0.65rem 0 0.9rem;
		border-radius: var(--radius-pill);
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border-strong);
		color: var(--color-text-muted);
		font-size: 0.86rem;
		box-shadow: inset 0 1px 0 var(--glass-highlight);
		transition:
			border-color var(--transition),
			background-color var(--transition),
			color var(--transition),
			transform 120ms ease-out;
	}

	.masthead-spotlight-bar:hover {
		color: var(--color-text);
		border-color: rgba(var(--color-accent-rgb), 0.38);
		background: var(--color-accent-soft);
	}

	.masthead-spotlight-bar:active {
		transform: scale(0.98);
	}

	.masthead-spotlight-placeholder {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.masthead-spotlight-bar kbd {
		flex-shrink: 0;
		padding: 0.16rem 0.44rem;
		border-radius: 999px;
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		color: var(--color-text-secondary);
	}

	/* 右舱：独立杂志当期封面卡 */
	.hero-dispatch {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		padding: clamp(1.35rem, 1.05rem + 1.4vw, 1.85rem);
	}

	.dispatch-ribbon {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
	}

	.dispatch-stamp {
		padding: 0.16rem 0.48rem;
		border-radius: 5px;
		background: var(--color-accent-soft);
		border: 1px solid rgba(var(--color-accent-rgb), 0.24);
		color: var(--color-accent);
		font-weight: 700;
		letter-spacing: 0.06em;
	}

	.dispatch-date {
		color: var(--color-text-muted);
	}

	.hero-main-media {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-inner);
		border: 1px solid var(--color-border);
		aspect-ratio: 16 / 9;
		background: var(--color-bg-tertiary);
	}

	.hero-main-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.dispatch-story {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.15rem;
		padding-top: 0.2rem;
		color: inherit;
	}

	.dispatch-story:hover {
		color: inherit;
	}

	.dispatch-story-body {
		display: grid;
		gap: 0.6rem;
	}

	.dispatch-category {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.78rem;
		font-weight: 620;
		color: var(--color-accent);
	}

	.dispatch-category::before {
		content: "";
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: currentColor;
	}

	.dispatch-title {
		font-family: var(--font-sans);
		font-size: clamp(1.28rem, 1.12rem + 0.55vw, 1.62rem);
		font-weight: 740;
		line-height: 1.28;
		letter-spacing: -0.025em;
		color: var(--color-text);
		transition: color var(--transition);
	}

	.dispatch-story:hover .dispatch-title {
		color: var(--color-accent);
	}

	.dispatch-excerpt {
		font-size: 0.9rem;
		line-height: 1.68;
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.dispatch-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding-top: 0.85rem;
		border-top: 1px solid var(--color-border);
	}

	.dispatch-readtime {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.dispatch-orb {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--color-text);
		color: var(--color-bg);
		font-family: var(--font-mono);
		font-size: 0.9rem;
		transition:
			background-color var(--transition),
			transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.dispatch-story:hover .dispatch-orb {
		background: var(--color-accent);
		color: #ffffff;
		transform: translate(2px, -2px);
	}

	.dispatch-empty {
		display: grid;
		gap: 0.45rem;
		margin-block: auto;
	}

	.dispatch-empty strong {
		font-size: 1.05rem;
		color: var(--color-text);
	}

	.dispatch-empty p {
		font-size: 0.88rem;
		line-height: 1.68;
		color: var(--color-text-muted);
	}

	.home-section {
		display: grid;
		gap: 1.2rem;
	}

	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.85rem;
		border-bottom: 1px solid var(--color-border);
	}

	.section-head-main {
		display: grid;
		gap: 0.36rem;
	}

	.section-index-code {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--color-text-muted);
		letter-spacing: 0.06em;
	}

	.section-more-link {
		display: inline-flex;
		align-items: center;
		gap: 0.34rem;
		padding: 0.36rem 0.78rem;
		border-radius: var(--radius-pill);
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--color-text-secondary);
