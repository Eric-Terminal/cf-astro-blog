---
import { env } from "cloudflare:workers";
import { and, asc, desc, eq, sql } from "drizzle-orm";
import PostCard from "@/components/PostCard.astro";
import { blogCategories, blogPosts } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";
import { estimateArticleReadStats, formatDate } from "@/lib/format";
import { getPublicPostVisibilityCondition } from "@/lib/public-content";
import { encodeRouteParam } from "@/lib/security";
import {
	buildHeroActionLinks,
	DEFAULT_SITE_APPEARANCE,
	getSiteAppearance,
	resolveSiteDescriptionFromAppearance,
} from "@/lib/site-appearance";
import { siteConfig } from "@/lib/types";

interface HomePostCardRow {
	title: string;
	slug: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
	cjkCharCount: number;
	latinWordCount: number;
	estimatedReadingMinutes: number;
}

let pinnedPosts: HomePostCardRow[] = [];
let recentPosts: HomePostCardRow[] = [];
let totalPublishedPosts = 0;
let homepageAppearance = DEFAULT_SITE_APPEARANCE;

function toHomePostCardRow(row: {
	title: string;
	slug: string;
	content: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
}): HomePostCardRow {
	const readingStats = estimateArticleReadStats(row.content);

	return {
		title: row.title,
		slug: row.slug,
		excerpt: row.excerpt,
		publishedAt: row.publishedAt,
		authorName: row.authorName,
		categoryName: row.categoryName,
		featuredImageKey: row.featuredImageKey,
		featuredImageAlt: row.featuredImageAlt,
		cjkCharCount: readingStats.cjkCharCount,
		latinWordCount: readingStats.latinWordCount,
		estimatedReadingMinutes: readingStats.estimatedReadingMinutes,
	};
}

try {
	const db = getDb(env.DB);
	const [appearanceResult, countRows, pinnedRows, recentRows] =
		await Promise.all([
			getSiteAppearance(db),
			db
				.select({ count: sql<number>`count(*)` })
				.from(blogPosts)
				.where(getPublicPostVisibilityCondition()),
			db
				.select({
					title: blogPosts.title,
					slug: blogPosts.slug,
					content: blogPosts.content,
					excerpt: blogPosts.excerpt,
					publishedAt: blogPosts.publishedAt,
					authorName: blogPosts.authorName,
					categoryName: blogCategories.name,
					featuredImageKey: blogPosts.featuredImageKey,
					featuredImageAlt: blogPosts.featuredImageAlt,
				})
				.from(blogPosts)
				.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
				.where(
					and(getPublicPostVisibilityCondition(), eq(blogPosts.isPinned, true)),
				)
				.orderBy(
					asc(blogPosts.pinnedOrder),
					desc(blogPosts.publishedAt),
					desc(blogPosts.createdAt),
				)
				.limit(6),
			db
				.select({
					title: blogPosts.title,
					slug: blogPosts.slug,
					content: blogPosts.content,
					excerpt: blogPosts.excerpt,
					publishedAt: blogPosts.publishedAt,
					authorName: blogPosts.authorName,
					categoryName: blogCategories.name,
					featuredImageKey: blogPosts.featuredImageKey,
					featuredImageAlt: blogPosts.featuredImageAlt,
				})
				.from(blogPosts)
				.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
				.where(
					and(
						getPublicPostVisibilityCondition(),
						eq(blogPosts.isPinned, false),
					),
				)
				.orderBy(desc(blogPosts.publishedAt), desc(blogPosts.createdAt))
				.limit(5),
		]);

	homepageAppearance = appearanceResult;
	totalPublishedPosts = countRows[0]?.count ?? 0;
	pinnedPosts = pinnedRows.map(toHomePostCardRow);
	recentPosts = recentRows.map(toHomePostCardRow);
} catch {
	// D1 未绑定时首页退化为空列表
}

const latestPost = [...pinnedPosts, ...recentPosts]
	.filter((post) => Boolean(post.publishedAt))
	.sort(
		(a, b) =>
			new Date(b.publishedAt ?? 0).getTime() -
			new Date(a.publishedAt ?? 0).getTime(),
	)[0];
const latestUpdateAt = latestPost?.publishedAt || null;
const latestUpdate = latestUpdateAt
	? formatDate(latestUpdateAt)
	: "尚无已发布文章";
const recentSectionSubheading =
	pinnedPosts.length > 0 ? "" : "按时间倒序收录近期思考与实践记录。";
const heroActions = buildHeroActionLinks(homepageAppearance);
const homepageMetaDescription = resolveSiteDescriptionFromAppearance(
	homepageAppearance,
	siteConfig.description,
);
const hasHeroImage = Boolean(homepageAppearance.heroMainImagePath);

function isInternalHref(href: string) {
	return href.startsWith("/") && !href.startsWith("//");
}
---

<Base title={siteConfig.name} description={homepageMetaDescription}>
	<section
		class:list={[
			"home-hero",
			"glass-panel",
			{ "home-hero-with-media": hasHeroImage },
		]}
		data-hero-depth
		data-tilt-card
		data-tilt-scale="0.52"
		data-tilt-shift-scale="0.82"
	>
		<div class="home-hero-copy">
			<div class="home-hero-eyebrow">
				<span class="section-kicker">{homepageAppearance.heroKicker}</span>
				<span class="home-hero-count">{totalPublishedPosts} 篇公开记录</span>
			</div>
			<h1 class="page-title">{homepageAppearance.heroTitle}</h1>
			<p class="page-intro">{homepageAppearance.heroIntro}</p>
			<div class="hero-actions">
				{
					heroActions.map((action, index) =>
						index === 1 ? (
							<span class="hero-search-bridge" transition:name="search-entry">
								<a
									href={action.href}
									class:list={["button", { "button-secondary": index > 0 }]}
									target={isInternalHref(action.href) ? undefined : "_blank"}
									rel={isInternalHref(action.href) ? undefined : "noopener noreferrer"}
								>
									{action.label}
								</a>
							</span>
						) : (
							<a
								href={action.href}
								class:list={["button", { "button-secondary": index > 0 }]}
								target={isInternalHref(action.href) ? undefined : "_blank"}
								rel={isInternalHref(action.href) ? undefined : "noopener noreferrer"}
							>
								<span>{action.label}</span>
								{index === 0 && <span aria-hidden="true">→</span>}
							</a>
						),
					)
				}
			</div>
		</div>

		<aside class="home-hero-aside" aria-label="站点最新动态">
			{
				homepageAppearance.heroMainImagePath && (
					<div class="hero-main-media">
						<img
							src={homepageAppearance.heroMainImagePath}
							alt=""
							loading="eager"
							decoding="async"
						/>
					</div>
				)
			}
			<div class="hero-dispatch">
				<div class="hero-dispatch-head">
					<span class="hero-dispatch-label">最近更新</span>
					{
						latestUpdateAt ? (
							<time
								class="hero-dispatch-date local-time-pending"
								datetime={latestUpdateAt}
								data-local-time="date"
							>
								{latestUpdate}
							</time>
						) : (
							<span class="hero-dispatch-date">{latestUpdate}</span>
						)
					}
				</div>
				{
					latestPost ? (
						<a
							href={`/blog/${encodeRouteParam(latestPost.slug)}`}
							class="hero-dispatch-post"
							data-astro-prefetch="hover"
						>
							<strong class="hero-dispatch-title">{latestPost.title}</strong>
							{latestPost.excerpt && (
								<p class="hero-dispatch-excerpt">{latestPost.excerpt}</p>
							)}
							<span class="hero-dispatch-meta">
								{latestPost.categoryName && <span>{latestPost.categoryName}</span>}
								<span>约 {latestPost.estimatedReadingMinutes} 分钟阅读</span>
								<span class="hero-dispatch-arrow" aria-hidden="true">→</span>
							</span>
						</a>
					) : (
						<p class="hero-dispatch-empty">
							围绕 Cloudflare、前端工程与系统设计的写作空间已就绪。
						</p>
					)
				}
			</div>
		</aside>
	</section>

	{
		pinnedPosts.length > 0 && (
			<section class="home-section" aria-labelledby="pinned-heading">
				<div class="section-head">
					<div class="section-head-main">
						<span class="section-kicker">置顶文章</span>
						<h2 id="pinned-heading" class="section-heading">精选与置顶</h2>
					</div>
				</div>

				<div class="home-grid home-grid-pinned">
					{pinnedPosts.map((post, index) => (
						<PostCard
							title={post.title}
							slug={post.slug}
							excerpt={post.excerpt}
							publishedAt={post.publishedAt}
							authorName={post.authorName}
							categoryName={post.categoryName}
							featuredImageKey={post.featuredImageKey}
							featuredImageAlt={post.featuredImageAlt}
							cjkCharCount={post.cjkCharCount}
							latinWordCount={post.latinWordCount}
							estimatedReadingMinutes={post.estimatedReadingMinutes}
							variant={index === 0 ? "featured" : "regular"}
						/>
					))}
				</div>
			</section>
		)
	}

	<section class="home-section" aria-labelledby="recent-heading">
		<div class="section-head">
			<div class="section-head-main">
				<span class="section-kicker">最近更新</span>
				<h2 id="recent-heading" class="section-heading">近期文章</h2>
				{recentSectionSubheading && (
					<p class="section-subheading">{recentSectionSubheading}</p>
				)}
			</div>
			<a href="/blog" class="section-more-link">
				<span>全部归档</span>
				<span aria-hidden="true">→</span>
			</a>
		</div>

		{recentPosts.length > 0 ? (
			<div class="home-grid">
				{recentPosts.map((post, index) => (
					<PostCard
						title={post.title}
						slug={post.slug}
						excerpt={post.excerpt}
						publishedAt={post.publishedAt}
						authorName={post.authorName}
						categoryName={post.categoryName}
						featuredImageKey={post.featuredImageKey}
						featuredImageAlt={post.featuredImageAlt}
						cjkCharCount={post.cjkCharCount}
						latinWordCount={post.latinWordCount}
						estimatedReadingMinutes={post.estimatedReadingMinutes}
						variant={pinnedPosts.length === 0 && index === 0 ? "featured" : "regular"}
					/>
				))}
			</div>
		) : (
			<div class="empty-state glass-panel">
				<p>还没有公开文章，先去后台发布第一篇内容。</p>
			</div>
		)}
	</section>
</Base>

<style>
	.home-hero {
		--hero-pointer-x: 0;
		--hero-pointer-y: 0;
		--hero-scroll-shift: 0px;
		--glass-panel-opacity: calc(var(--hero-card-opacity, 14) / 100);
		--glass-panel-blur: var(--hero-card-blur, 18px);
		display: grid;
		grid-template-columns: minmax(0, 1.32fr) minmax(18rem, 0.88fr);
		align-items: stretch;
		gap: clamp(1.5rem, 3vw, 2.8rem);
		padding: clamp(1.6rem, 1.2rem + 2.4vw, 2.8rem);
		transform:
			perspective(1280px)
			rotateX(var(--tilt-rotate-x, 0deg))
			rotateY(var(--tilt-rotate-y, 0deg));
		transform-style: preserve-3d;
		transition:
			transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
			border-color var(--transition),
			box-shadow var(--transition);
		animation: hero-enter 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.home-hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1.15rem;
		min-width: 0;
		transform: translate3d(
			calc(var(--tilt-shift-x, 0) * 3px),
			calc(var(--tilt-shift-y, 0) * 3px),
			12px
		);
		transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.home-hero-eyebrow {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.home-hero-count {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
		padding-left: 0.75rem;
		border-left: 1px solid var(--color-border-strong);
	}

	.home-hero-copy .page-title {
		max-width: 16ch;
		font-size: clamp(2.1rem, 1.65rem + 2.1vw, 3.35rem);
		line-height: 1.14;
		letter-spacing: -0.032em;
	}

	.home-hero-copy .page-intro {
		white-space: pre-line;
		max-width: 38rem;
		color: var(--color-text-secondary);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem;
		margin-top: 0.35rem;
	}

	.hero-search-bridge {
		display: inline-flex;
	}

	.home-hero-aside {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		padding-left: clamp(1.2rem, 2.2vw, 2rem);
		border-left: 1px solid var(--color-border);
		min-width: 0;
		transform: translate3d(
			calc(var(--tilt-shift-x, 0) * 5px),
			calc(var(--tilt-shift-y, 0) * 5px),
			20px
		);
		transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.hero-main-media {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-inner);
		border: 1px solid var(--color-border);
		aspect-ratio: 16 / 10;
		background: var(--color-bg-tertiary);
	}

	.hero-main-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-dispatch {
		display: flex;
		flex-direction: column;
		justify-content: center;
		flex: 1;
		gap: 0.85rem;
	}

	.hero-dispatch-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding-bottom: 0.65rem;
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.hero-dispatch-label {
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-weight: 600;
	}

	.hero-dispatch-post {
		display: grid;
		gap: 0.55rem;
		padding: 0.9rem 1rem;
		margin-inline: -0.35rem;
		border-radius: var(--radius-inner);
		border: 1px solid transparent;
		background: var(--color-bg-tertiary);
		transition:
			background-color var(--transition),
			border-color var(--transition),
			transform var(--transition);
	}

	.hero-dispatch-post:hover {
		color: inherit;
		background: var(--color-accent-soft);
		border-color: rgba(var(--color-accent-rgb), 0.24);
		transform: translateY(-2px);
	}

	.hero-dispatch-title {
		font-size: 1.04rem;
		font-weight: 680;
		line-height: 1.38;
		letter-spacing: -0.015em;
		color: var(--color-text);
		transition: color var(--transition);
	}

	.hero-dispatch-post:hover .hero-dispatch-title {
		color: var(--color-accent);
	}

	.hero-dispatch-excerpt {
		font-size: 0.86rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.hero-dispatch-meta {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--color-text-muted);
	}

	.hero-dispatch-arrow {
		margin-left: auto;
		color: var(--color-accent);
		transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.hero-dispatch-post:hover .hero-dispatch-arrow {
		transform: translateX(3px);
	}

	.hero-dispatch-empty {
		font-size: 0.9rem;
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	.home-section {
		display: grid;
		gap: 1.25rem;
	}

	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.85rem;
		border-bottom: 1px solid var(--color-border);
	}

	.section-head-main {
		display: grid;
		gap: 0.38rem;
	}

	.section-more-link {
		display: inline-flex;
		align-items: center;
		gap: 0.32rem;
		font-size: 0.86rem;
		font-weight: 600;
		color: var(--color-text-secondary);
		white-space: nowrap;
	}

	.section-more-link:hover {
		color: var(--color-accent);
	}

	.home-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
	}

	@keyframes hero-enter {
		from {
			opacity: 0;
			transform: translate3d(0, 12px, 0);
		}

		to {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
	}

	@media (max-width: 920px) {
		.home-hero {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.home-hero-aside {
			padding-left: 0;
			padding-top: 1.25rem;
			border-left: none;
			border-top: 1px solid var(--color-border);
		}
	}

	@media (max-width: 640px) {
		.home-hero {
			padding: 1.25rem;
		}

		.hero-dispatch-post {
			margin-inline: 0;
		}

		.section-head {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.home-hero,
		.home-hero-copy,
		.home-hero-aside {
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-hero,
		.home-hero-copy,
		.home-hero-aside {
			animation: none;
			transition: none;
			transform: none;
		}
	}
</style>
