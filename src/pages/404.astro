---
import Base from "@/layouts/Base.astro";

Astro.response.status = 404;
const missingPath = Astro.url.pathname || "/";
---

<Base title="404 - 页面不存在" description="页面不存在，不过你可以试试这个终端彩蛋。">
	<section
		class="not-found-terminal glass-panel"
		data-not-found-terminal="true"
		data-ai-endpoint="/api/ai/terminal-404"
		data-missing-path={missingPath}
	>
		<header class="terminal-header">
			<span class="terminal-dot terminal-dot-danger"></span>
			<span class="terminal-dot terminal-dot-warn"></span>
			<span class="terminal-dot terminal-dot-ok"></span>
			<strong class="terminal-title">404-terminal://not-found</strong>
		</header>

		<div class="terminal-log" data-terminal-log="true" role="log" aria-live="polite">
			<p class="terminal-line terminal-line-system">[404] 未找到路径：{missingPath}</p>
			<p class="terminal-line terminal-line-system">欢迎来到彩蛋终端，输入命令后将由外接 AI 返回终端风格结果。</p>
			<p class="terminal-line terminal-line-system">可先试试：help、whoami、ls、pwd、about</p>
		</div>

		<form class="terminal-form" data-terminal-form="true">
			<label class="terminal-input-wrap" for="terminalCommandInput">
				<span class="terminal-prompt">guest@404:~$</span>
				<input
					id="terminalCommandInput"
					class="terminal-input"
					name="command"
					type="text"
					placeholder="输入命令并回车"
					autocomplete="off"
					spellcheck="false"
					data-terminal-input="true"
					maxlength="200"
					required
				/>
			</label>
			<button type="submit" class="terminal-submit">执行</button>
		</form>
	</section>
	<script is:inline src="/not-found-terminal.js"></script>
</Base>

<style>
	.not-found-terminal {
		display: grid;
		gap: 0.95rem;
		padding: clamp(1.15rem, 0.9rem + 1vw, 1.65rem);
		border: 1px solid var(--color-border-strong);
		/* 透明度/模糊跟随后台「卡片」控制，与全站光学面板保持一致 */
		--glass-panel-opacity: calc(var(--hero-card-opacity, 14) / 100);
		--glass-panel-blur: var(--hero-card-blur, 18px);
		--terminal-cmd-color: #6ee7b7;
		--terminal-error-color: #fca5a5;
		--terminal-prompt-color: #4da3ff;
	}

	:root[data-theme="light"] .not-found-terminal {
		--terminal-cmd-color: #047857;
		--terminal-error-color: #dc2626;
		--terminal-prompt-color: #0066dc;
	}

	@media (prefers-color-scheme: light) {
		:root:not([data-theme="dark"]) .not-found-terminal {
			--terminal-cmd-color: #047857;
			--terminal-error-color: #dc2626;
			--terminal-prompt-color: #0066dc;
		}
	}

	.terminal-header {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding-bottom: 0.55rem;
		border-bottom: 1px solid var(--color-border);
	}

	.terminal-dot {
		width: 0.62rem;
		height: 0.62rem;
		border-radius: 999px;
	}

	.terminal-dot-danger {
		background: #ff5f56;
	}

	.terminal-dot-warn {
		background: #ffbd2e;
	}

	.terminal-dot-ok {
		background: #27c93f;
	}

	.terminal-title {
		margin-left: 0.35rem;
		font-size: 0.8rem;
		color: var(--color-text-secondary);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Courier New", monospace;
	}

	.terminal-log {
		min-height: 300px;
		max-height: min(56vh, 520px);
		overflow: auto;
		padding: 0.2rem 0.1rem;
		display: grid;
		gap: 0.32rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Courier New", monospace;
		font-size: 0.88rem;
		line-height: 1.48;
	}

	.terminal-line {
		margin: 0;
		white-space: pre-wrap;
		word-break: break-word;
		color: var(--color-text);
	}

	.terminal-line-command {
		color: var(--terminal-cmd-color);
	}

	.terminal-line-system {
		color: var(--color-text-muted);
	}

	.terminal-line-error {
		color: var(--terminal-error-color);
	}

	.terminal-form {
		display: flex;
		gap: 0.62rem;
		align-items: center;
	}

	.terminal-input-wrap {
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.62rem 0.72rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: var(--color-bg-tertiary);
	}

	.terminal-prompt {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Courier New", monospace;
		font-size: 0.84rem;
		color: var(--terminal-prompt-color);
		white-space: nowrap;
	}

	.terminal-input {
		flex: 1;
		min-width: 0;
		border: none;
		outline: none;
		color: var(--color-text);
		background: transparent;
		font: inherit;
	}

	.terminal-input::placeholder {
		color: var(--color-text-placeholder);
	}

	.terminal-submit {
		border: 1px solid transparent;
		background: var(--color-text);
		color: var(--color-bg);
		padding: 0.62rem 1rem;
		border-radius: var(--radius-inner);
		font-size: 0.84rem;
		font-weight: 600;
		cursor: pointer;
		transition:
			background-color var(--transition),
			transform 100ms ease-out;
	}

	.terminal-submit:hover {
		background: var(--color-accent);
	}

	.terminal-submit:active {
		transform: scale(0.96);
	}

	@media (max-width: 640px) {
		.terminal-form {
			flex-direction: column;
			align-items: stretch;
		}

		.terminal-submit {
			width: 100%;
		}
	}
</style>
