---
import { env } from "cloudflare:workers";
import "@/styles/post-card.css";
import SearchBox from "@/components/Search.astro";
import { blogCategories, blogTags } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";
import { sanitizeSlug } from "@/lib/security";

function normalizeDateInput(value: string | null) {
	if (!value) {
		return "";
	}

	const normalized = value.trim();
	if (!/^\d{4}-\d{2}-\d{2}$/u.test(normalized)) {
		return "";
	}

	const parsed = new Date(`${normalized}T00:00:00`);
	if (Number.isNaN(parsed.getTime())) {
		return "";
	}

	const [year, month, day] = normalized.split("-").map((item) => Number(item));
	if (
		parsed.getFullYear() !== year ||
		parsed.getMonth() + 1 !== month ||
		parsed.getDate() !== day
	) {
		return "";
	}

	return normalized;
}

const query = Astro.url.searchParams.get("q")?.trim() || "";
const rawSelectedCategory =
	Astro.url.searchParams.get("category")?.trim().toLowerCase() || "";
const selectedCategory = sanitizeSlug(rawSelectedCategory) || "";
const selectedTags = [
	...new Set(
		Astro.url.searchParams
			.getAll("tags")
			.map((item) => sanitizeSlug(item))
			.filter((item): item is string => Boolean(item)),
	),
];
const selectedDateFrom = normalizeDateInput(
	Astro.url.searchParams.get("dateFrom"),
);
const selectedDateTo = normalizeDateInput(Astro.url.searchParams.get("dateTo"));

const hasSearchCriteria = Boolean(
	query ||
		selectedCategory ||
		selectedTags.length > 0 ||
		selectedDateFrom ||
		selectedDateTo,
);

let categories: Array<{ slug: string; name: string }> = [];
let tags: Array<{ slug: string; name: string }> = [];

try {
	const db = getDb(env.DB);
	const [allCategories, allTags] = await Promise.all([
		db
			.select({ slug: blogCategories.slug, name: blogCategories.name })
			.from(blogCategories)
			.orderBy(blogCategories.name),
		db
			.select({ slug: blogTags.slug, name: blogTags.name })
			.from(blogTags)
			.orderBy(blogTags.name),
	]);

	categories = allCategories;
	tags = allTags;
} catch {
	// D1 未绑定时回退为空选项
}

const activeFilters = [
	query ? `关键词：${query}` : "",
	selectedCategory ? `分类：${selectedCategory}` : "",
	selectedTags.length > 0 ? `标签：${selectedTags.join("、")}` : "",
	selectedDateFrom || selectedDateTo
		? `时间：${selectedDateFrom || "不限"} 至 ${selectedDateTo || "不限"}`
		: "",
].filter(Boolean);
---

<Base title="搜索" description="使用 Pagefind 在浏览器本地检索文章内容">
	<section
		class="search-hero glass-panel"
		data-tilt-card
		data-tilt-scale="0.34"
		data-tilt-shift-scale="0.58"
	>
		<div class="search-hero-head">
			<span class="section-kicker">站内检索</span>
			<h1 class="page-title">搜索文章</h1>
			<p class="page-intro">
				由本地离线索引驱动，支持按关键词、分类、标签与发布时间组合检索。
			</p>
		</div>
		<div class="search-entry-stage" transition:name="search-entry">
			<SearchBox
				initialQuery={query}
				categories={categories}
				tags={tags}
				selectedCategory={selectedCategory}
				selectedTags={selectedTags}
				selectedDateFrom={selectedDateFrom}
				selectedDateTo={selectedDateTo}
			/>
		</div>
	</section>

	<section class="search-results-block" id="search-results-section" style={hasSearchCriteria ? undefined : "display:none"}>
		<div class="section-head">
			<div>
				<h2 class="section-heading">检索结果</h2>
				<p class="section-subheading">
					{activeFilters.length > 0 ? activeFilters.join(" · ") : "输入关键词后开始检索"}
				</p>
			</div>
			<p id="pagefind-results-summary" class="results-summary">
				{hasSearchCriteria ? "正在加载搜索结果..." : "输入关键词或筛选条件后开始搜索"}
			</p>
		</div>
		<div id="pagefind-search-results" class="search-grid" />
	</section>

	<script is:inline type="module" src="/pagefind-search.js"></script>
</Base>

<style>
	.search-hero {
		--glass-panel-opacity: calc(var(--hero-card-opacity, 14) / 100);
		--glass-panel-blur: var(--hero-card-blur, 18px);
		display: grid;
		gap: 1.35rem;
		padding: clamp(1.5rem, 1.1rem + 2vw, 2.4rem);
		transform:
			perspective(1200px)
			rotateX(var(--tilt-rotate-x, 0deg))
			rotateY(var(--tilt-rotate-y, 0deg));
		transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.search-hero-head {
		display: grid;
		gap: 0.7rem;
	}

	.search-entry-stage {
		width: 100%;
	}

	.search-results-block {
		display: grid;
		gap: 1.2rem;
	}

	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.85rem;
		border-bottom: 1px solid var(--color-border);
	}

	.results-summary {
		font-family: var(--font-mono);
		color: var(--color-text-muted);
		font-size: 0.84rem;
		font-variant-numeric: tabular-nums;
	}

	.search-grid {
		display: grid;
		gap: 1rem;
	}

	@media (max-width: 840px) {
		.section-head {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.search-hero {
			transform: none;
		}
	}
</style>
