---
import { env } from "cloudflare:workers";
import { desc, eq, sql } from "drizzle-orm";
import PostCard from "@/components/PostCard.astro";
import { blogCategories, blogPosts } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";
import { estimateArticleReadStats } from "@/lib/format";
import { getPublicPostVisibilityCondition } from "@/lib/public-content";

const page = Math.max(
	1,
	Number(Astro.url.searchParams.get("page") || "1") || 1,
);
const limit = 10;
const offset = (page - 1) * limit;

interface ArchivePostSourceRow {
	title: string;
	slug: string;
	content: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
}

interface ArchivePostCardRow {
	title: string;
	slug: string;
	excerpt: string | null;
	publishedAt: string | null;
	authorName: string | null;
	categoryName: string | null;
	featuredImageKey: string | null;
	featuredImageAlt: string | null;
	cjkCharCount: number;
	latinWordCount: number;
	estimatedReadingMinutes: number;
}

let posts: ArchivePostCardRow[] = [];
let totalPosts = 0;

try {
	const db = getDb(env.DB);

	const [countResult, rows] = await Promise.all([
		db
			.select({ count: sql<number>`count(*)` })
			.from(blogPosts)
			.where(getPublicPostVisibilityCondition()),
		db
			.select({
				title: blogPosts.title,
				slug: blogPosts.slug,
				content: blogPosts.content,
				excerpt: blogPosts.excerpt,
				publishedAt: blogPosts.publishedAt,
				authorName: blogPosts.authorName,
				categoryName: blogCategories.name,
				featuredImageKey: blogPosts.featuredImageKey,
				featuredImageAlt: blogPosts.featuredImageAlt,
			})
			.from(blogPosts)
			.leftJoin(blogCategories, eq(blogPosts.categoryId, blogCategories.id))
			.where(getPublicPostVisibilityCondition())
			.orderBy(desc(blogPosts.publishedAt))
			.limit(limit)
			.offset(offset),
	]);
	totalPosts = countResult[0]?.count ?? 0;

	posts = (rows as ArchivePostSourceRow[]).map((row) => {
		const readingStats = estimateArticleReadStats(row.content);

		return {
			title: row.title,
			slug: row.slug,
			excerpt: row.excerpt,
			publishedAt: row.publishedAt,
			authorName: row.authorName,
			categoryName: row.categoryName,
			featuredImageKey: row.featuredImageKey,
			featuredImageAlt: row.featuredImageAlt,
			cjkCharCount: readingStats.cjkCharCount,
			latinWordCount: readingStats.latinWordCount,
			estimatedReadingMinutes: readingStats.estimatedReadingMinutes,
		};
	});
} catch {
	// D1 未绑定时回退为空列表
}

const totalPages = Math.ceil(totalPosts / limit);
---

<Base title="归档" description="按时间顺序浏览全部已发布文章">
	<section
		class="archive-hero glass-panel"
		data-tilt-card
		data-tilt-scale="0.38"
		data-tilt-shift-scale="0.65"
	>
		<div class="archive-hero-copy">
			<span class="section-kicker">归档目录</span>
			<h1 class="page-title">全部文章</h1>
			<p class="page-intro">
				按发布时间倒序收录全部技术记录与复盘笔记。
			</p>
		</div>
		<div class="archive-hero-meta" aria-label="归档统计">
			<div class="archive-stat">
				<span>已发布篇目</span>
				<strong>{totalPosts}</strong>
			</div>
			<div class="archive-stat">
				<span>当前页码</span>
				<strong>{page} / {Math.max(totalPages, 1)}</strong>
			</div>
		</div>
	</section>

	{posts.length > 0 ? (
		<div class="archive-grid">
			{posts.map((post, index) => (
				<PostCard
					title={post.title}
					slug={post.slug}
					excerpt={post.excerpt}
					publishedAt={post.publishedAt}
					authorName={post.authorName}
					categoryName={post.categoryName}
					featuredImageKey={post.featuredImageKey}
					featuredImageAlt={post.featuredImageAlt}
					cjkCharCount={post.cjkCharCount}
					latinWordCount={post.latinWordCount}
					estimatedReadingMinutes={post.estimatedReadingMinutes}
					variant={page === 1 && index === 0 ? "featured" : "regular"}
				/>
			))}
		</div>
	) : (
		<div class="empty-state glass-panel">
			<p>还没有已发布文章。</p>
		</div>
	)}

	{totalPages > 1 && (
		<nav class="pagination glass-panel" aria-label="分页">
			{page > 1 ? (
				<a href={`/blog?page=${page - 1}`} class="button button-secondary">← 上一页</a>
			) : (
				<span class="pagination-placeholder" />
			)}
			<span class="pagination-status">第 {page} 页 · 共 {totalPages} 页</span>
			{page < totalPages ? (
				<a href={`/blog?page=${page + 1}`} class="button button-secondary">下一页 →</a>
			) : (
				<span class="pagination-placeholder" />
			)}
		</nav>
	)}
</Base>

<style>
	.archive-hero,
	.pagination {
		--glass-panel-opacity: calc(var(--hero-card-opacity, 14) / 100);
		--glass-panel-blur: var(--hero-card-blur, 18px);
	}

	.archive-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) auto;
		align-items: end;
		gap: 1.5rem 2.5rem;
		padding: clamp(1.5rem, 1.1rem + 2vw, 2.4rem);
		transform:
			perspective(1200px)
			rotateX(var(--tilt-rotate-x, 0deg))
			rotateY(var(--tilt-rotate-y, 0deg));
		transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.archive-hero-copy {
		display: grid;
		gap: 0.75rem;
	}

	.archive-hero-meta {
		display: flex;
		align-items: stretch;
		gap: 1.5rem;
		padding-left: 2rem;
		border-left: 1px solid var(--color-border);
	}

	.archive-stat {
		display: grid;
		align-content: end;
		gap: 0.25rem;
	}

	.archive-stat span {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.archive-stat strong {
		font-family: var(--font-mono);
		font-size: clamp(1.5rem, 1.25rem + 0.9vw, 2.05rem);
		font-weight: 700;
		line-height: 1.1;
		color: var(--color-text);
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
	}

	.archive-grid {
		display: grid;
		gap: 1rem;
	}

	.pagination {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		padding: 0.9rem 1.2rem;
	}

	.pagination-status {
		text-align: center;
		font-family: var(--font-mono);
		color: var(--color-text-muted);
		font-size: 0.84rem;
		font-variant-numeric: tabular-nums;
	}

	.pagination .button:last-child {
		justify-self: end;
	}

	.pagination .button:first-child {
		justify-self: start;
	}

	.pagination-placeholder {
		display: block;
		min-height: 1px;
	}

	@media (max-width: 840px) {
		.archive-hero {
			grid-template-columns: 1fr;
		}

		.archive-hero-meta {
			padding-left: 0;
			padding-top: 1rem;
			border-left: none;
			border-top: 1px solid var(--color-border);
			gap: 2rem;
		}

		.pagination {
			grid-template-columns: 1fr;
		}

		.pagination .button:last-child,
		.pagination .button:first-child {
			justify-self: stretch;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.archive-hero {
			transform: none;
		}
	}
</style>
