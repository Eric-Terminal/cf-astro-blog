---
import { env } from "cloudflare:workers";
import { asc, eq } from "drizzle-orm";
import { friendLinks } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";

let approvedLinks: Array<{
	id: number;
	name: string;
	siteUrl: string;
	avatarUrl: string | null;
	avatarProxyUrl?: string | null;
	description: string;
	contact: string;
}> = [];

function buildFriendAvatarProxyUrl(url: string | null): string | null {
	if (!url) {
		return null;
	}

	return `/api/friend-links/avatar?url=${encodeURIComponent(url)}`;
}

function formatHostname(url: string): string {
	try {
		return new URL(url).hostname.replace(/^www\./u, "");
	} catch {
		return url;
	}
}

try {
	const db = getDb(env.DB);

	approvedLinks = await db
		.select({
			id: friendLinks.id,
			name: friendLinks.name,
			siteUrl: friendLinks.siteUrl,
			avatarUrl: friendLinks.avatarUrl,
			description: friendLinks.description,
			contact: friendLinks.contact,
		})
		.from(friendLinks)
		.where(eq(friendLinks.status, "approved"))
		.orderBy(asc(friendLinks.name));
	approvedLinks = approvedLinks.map((item) => ({
		...item,
		avatarProxyUrl: buildFriendAvatarProxyUrl(item.avatarUrl),
	}));
} catch {
	// D1 未绑定时回退为空列表
}
---

<Base title="友链" description="展示已收录的同行者站点与独立博客。">
	<section
		class="friends-hero glass-panel"
		data-tilt-card
		data-tilt-scale="0.34"
		data-tilt-shift-scale="0.58"
	>
		<div class="friends-hero-copy">
			<span class="section-kicker">PEER NETWORK</span>
			<h1 class="page-title">同行者星图</h1>
			<p class="page-intro">收录长期主义的独立技术博客与数字花园，每一张都是通往另一处思考空间的通行证。</p>
		</div>
		<div class="friends-hero-count" aria-label="友链数量">
			<span>NODES ONLINE</span>
			<strong>{String(approvedLinks.length).padStart(2, "0")}</strong>
		</div>
	</section>

	{approvedLinks.length > 0 ? (
		<ul class="friend-pass-grid">
			{approvedLinks.map((item, idx) => (
				<li class="friend-pass-cell">
					<a
						href={item.siteUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="friend-pass glass-panel"
						data-tilt-card
						data-tilt-scale="0.55"
						data-tilt-shift-scale="0.7"
					>
						<div class="friend-pass-top">
							<div class="friend-pass-avatar" aria-hidden="true">
								{item.avatarUrl ? (
									<img
										src={item.avatarProxyUrl || undefined}
										alt=""
										loading="lazy"
										decoding="async"
										referrerpolicy="no-referrer"
									/>
								) : (
									<span>{item.name.slice(0, 1)}</span>
								)}
							</div>
							<span class="friend-pass-serial">
								NODE #{String(idx + 1).padStart(2, "0")}
							</span>
						</div>

						<div class="friend-pass-body">
							<strong class="friend-pass-name">{item.name}</strong>
							{item.description ? (
								<p class="friend-pass-desc">{item.description}</p>
							) : (
								<p class="friend-pass-desc">独立技术写作与实践记录空间。</p>
							)}
						</div>

						<div class="friend-pass-foot">
							<span class="friend-pass-host">{formatHostname(item.siteUrl)}</span>
							<span class="friend-pass-orb" aria-hidden="true">↗</span>
						</div>
					</a>
				</li>
			))}
		</ul>
	) : (
		<div class="empty-state glass-panel">
			<p>当前还没有公开友链，欢迎申请第一条。</p>
		</div>
	)}

	<section class="friend-apply-entry glass-panel" aria-label="友链申请入口">
		<a href="/friends/apply" class="friend-apply-link">
			<div class="friend-apply-badge">EXCHANGE PASS</div>
			<div class="friend-apply-copy">
				<strong>申请加入同行者友链</strong>
				<small>提交站点名称、链接与简介，审核通过后即点亮一枚专属节点名片。</small>
			</div>
			<span class="friend-apply-cta">填写申请 →</span>
		</a>
	</section>
</Base>

<style>
	.friends-hero,
	.friend-pass,
	.friend-apply-entry {
		--glass-panel-opacity: calc(var(--hero-card-opacity, 14) / 100);
		--glass-panel-blur: var(--hero-card-blur, 18px);
	}

	.friends-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 1.5rem 2rem;
		padding: clamp(1.5rem, 1.1rem + 2vw, 2.35rem);
		transform:
			perspective(1200px)
			rotateX(var(--tilt-rotate-x, 0deg))
			rotateY(var(--tilt-rotate-y, 0deg));
		transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.friends-hero-copy {
		display: grid;
		gap: 0.7rem;
	}

	.friends-hero-count {
		display: grid;
		align-content: end;
		gap: 0.22rem;
		padding-left: 1.8rem;
		border-left: 1px solid var(--color-border);
	}

	.friends-hero-count span {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
	}

	.friends-hero-count strong {
		font-family: var(--font-mono);
		font-size: clamp(1.55rem, 1.3rem + 0.9vw, 2.15rem);
		font-weight: 750;
		line-height: 1.08;
		color: var(--color-text);
		font-variant-numeric: tabular-nums;
	}

	/* 去套娃化 3D 通行证网格：每张友链自身即是独立的光学追光面板 */
	.friend-pass-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.05rem;
	}

	.friend-pass-cell {
		min-width: 0;
	}

	.friend-pass {
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.1rem;
		padding: 1.25rem;
		color: inherit;
		transform:
			perspective(1100px)
			rotateX(var(--tilt-rotate-x, 0deg))
			rotateY(var(--tilt-rotate-y, 0deg));
		transition:
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
			border-color var(--transition),
			box-shadow var(--transition);
	}

	.friend-pass:hover {
		color: inherit;
		border-color: rgba(var(--color-accent-rgb), 0.32);
	}

	.friend-pass-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.friend-pass-avatar {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		overflow: hidden;
		display: grid;
		place-items: center;
		background: var(--color-accent-soft);
		border: 1px solid var(--color-border-strong);
		font-weight: 750;
		color: var(--color-accent);
		flex-shrink: 0;
	}

	.friend-pass-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.friend-pass-serial {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
	}

	.friend-pass-body {
		display: grid;
		gap: 0.42rem;
	}

	.friend-pass-name {
		font-size: 1.05rem;
		font-weight: 720;
		letter-spacing: -0.018em;
		color: var(--color-text);
		transition: color var(--transition);
	}

	.friend-pass:hover .friend-pass-name {
		color: var(--color-accent);
	}

	.friend-pass-desc {
		font-size: 0.86rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.friend-pass-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--color-border);
	}

	.friend-pass-host {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--color-text-muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.friend-pass-orb {
		width: 1.75rem;
		height: 1.75rem;
		flex-shrink: 0;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--color-text-secondary);
		transition:
			background-color var(--transition),
			color var(--transition),
			transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.friend-pass:hover .friend-pass-orb {
		background: var(--color-text);
		color: var(--color-bg);
		border-color: transparent;
		transform: translate(2px, -2px);
	}

	.friend-apply-link {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.35rem;
		padding: 1.25rem 1.45rem;
		color: inherit;
	}

	.friend-apply-badge {
		padding: 0.24rem 0.58rem;
		border-radius: 6px;
		background: var(--color-accent-soft);
		border: 1px solid rgba(var(--color-accent-rgb), 0.26);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--color-accent);
	}

	.friend-apply-copy {
		flex: 1 1 18rem;
		display: grid;
		gap: 0.2rem;
	}

	.friend-apply-copy strong {
		font-size: 0.98rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.friend-apply-copy small {
		font-size: 0.85rem;
		color: var(--color-text-secondary);
	}

	.friend-apply-cta {
		padding: 0.48rem 0.95rem;
		border-radius: var(--radius-pill);
		background: var(--color-text);
		color: var(--color-bg);
		font-size: 0.84rem;
		font-weight: 620;
		transition: background-color var(--transition);
	}

	.friend-apply-link:hover {
		color: inherit;
	}

	.friend-apply-link:hover .friend-apply-cta {
		background: var(--color-accent);
		color: #ffffff;
	}

	@media (max-width: 960px) {
		.friend-pass-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 680px) {
		.friends-hero {
			grid-template-columns: 1fr;
		}

		.friends-hero-count {
			padding-left: 0;
			padding-top: 0.85rem;
			border-left: none;
			border-top: 1px solid var(--color-border);
		}

		.friend-pass-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.friends-hero,
		.friend-pass {
			transform: none;
		}
	}
</style>
