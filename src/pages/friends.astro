---
import { env } from "cloudflare:workers";
import { asc, eq } from "drizzle-orm";
import { friendLinks } from "@/db/schema";
import Base from "@/layouts/Base.astro";
import { getDb } from "@/lib/db";

let approvedLinks: Array<{
	id: number;
	name: string;
	siteUrl: string;
	avatarUrl: string | null;
	avatarProxyUrl?: string | null;
	description: string;
	contact: string;
}> = [];

function buildFriendAvatarProxyUrl(url: string | null): string | null {
	if (!url) {
		return null;
	}

	return `/api/friend-links/avatar?url=${encodeURIComponent(url)}`;
}

function formatHostname(url: string): string {
	try {
		return new URL(url).hostname.replace(/^www\./u, "");
	} catch {
		return url;
	}
}

try {
	const db = getDb(env.DB);

	approvedLinks = await db
		.select({
			id: friendLinks.id,
			name: friendLinks.name,
			siteUrl: friendLinks.siteUrl,
			avatarUrl: friendLinks.avatarUrl,
			description: friendLinks.description,
			contact: friendLinks.contact,
		})
		.from(friendLinks)
		.where(eq(friendLinks.status, "approved"))
		.orderBy(asc(friendLinks.name));
	approvedLinks = approvedLinks.map((item) => ({
		...item,
		avatarProxyUrl: buildFriendAvatarProxyUrl(item.avatarUrl),
	}));
} catch {
	// D1 未绑定时回退为空列表
}
---

<Base title="友链" description="展示已收录的同行者站点与独立博客。">
	<section
		class="friends-hero glass-panel"
		data-tilt-card
		data-tilt-scale="0.34"
		data-tilt-shift-scale="0.58"
	>
		<div class="friends-hero-copy">
			<span class="section-kicker">同行站点</span>
			<h1 class="page-title">友情链接</h1>
			<p class="page-intro">收录持续输出技术与思考的独立博客。欢迎在底部提交交换申请。</p>
		</div>
		<div class="friends-hero-count" aria-label="友链数量">
			<span>已收录</span>
			<strong>{approvedLinks.length}</strong>
		</div>
	</section>

	<section class="friends-list glass-panel">
		{approvedLinks.length > 0 ? (
			<ul class="friend-link-list">
				{approvedLinks.map((item) => (
					<li class="friend-link-item">
						<a
							href={item.siteUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="friend-link-card"
						>
							<div class="friend-link-avatar" aria-hidden="true">
								{item.avatarUrl ? (
									<img
										src={item.avatarProxyUrl || undefined}
										alt=""
										loading="lazy"
										decoding="async"
										referrerpolicy="no-referrer"
									/>
								) : (
									<span>{item.name.slice(0, 1)}</span>
								)}
							</div>
							<div class="friend-link-body">
								<div class="friend-link-title-row">
									<strong class="friend-link-name">{item.name}</strong>
									<span class="friend-link-arrow" aria-hidden="true">↗</span>
								</div>
								<span class="friend-link-host">{formatHostname(item.siteUrl)}</span>
								{item.description ? <p class="friend-link-desc">{item.description}</p> : null}
							</div>
						</a>
					</li>
				))}
			</ul>
		) : (
			<div class="empty-state">
				<p>当前还没有公开友链，欢迎申请第一条。</p>
			</div>
		)}
	</section>

	<section class="friend-apply-entry glass-panel" aria-label="友链申请入口">
		<a href="/friends/apply" class="friend-apply-link">
			<span class="friend-apply-copy">
				<strong>申请加入友链</strong>
				<small>填写站点名称、地址与简介，审核通过后自动展示在此列表中。</small>
			</span>
			<span class="friend-apply-icon" aria-hidden="true">→</span>
		</a>
	</section>
</Base>

<style>
	.friends-hero,
	.friends-list,
	.friend-apply-entry {
		--glass-panel-opacity: calc(var(--hero-card-opacity, 14) / 100);
		--glass-panel-blur: var(--hero-card-blur, 18px);
	}

	.friends-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 1.5rem 2rem;
		padding: clamp(1.5rem, 1.1rem + 2vw, 2.4rem);
		transform:
			perspective(1200px)
			rotateX(var(--tilt-rotate-x, 0deg))
			rotateY(var(--tilt-rotate-y, 0deg));
		transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.friends-hero-copy {
		display: grid;
		gap: 0.7rem;
	}

	.friends-hero-count {
		display: grid;
		align-content: end;
		gap: 0.2rem;
		padding-left: 1.8rem;
		border-left: 1px solid var(--color-border);
	}

	.friends-hero-count span {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.friends-hero-count strong {
		font-family: var(--font-mono);
		font-size: clamp(1.5rem, 1.25rem + 0.9vw, 2.05rem);
		font-weight: 700;
		line-height: 1.1;
		color: var(--color-text);
		font-variant-numeric: tabular-nums;
	}

	.friends-list {
		padding: clamp(1rem, 0.8rem + 1vw, 1.4rem);
	}

	.friend-link-list {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.friend-link-item {
		min-width: 0;
	}

	.friend-link-card {
		display: flex;
		gap: 0.85rem;
		align-items: flex-start;
		height: 100%;
		padding: 1rem 1.05rem;
		border-radius: var(--radius-inner);
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
		transition:
			transform var(--transition),
			border-color var(--transition),
			background-color var(--transition);
	}

	.friend-link-card:hover {
		color: inherit;
		transform: translateY(-2px);
		border-color: rgba(var(--color-accent-rgb), 0.3);
		background: var(--color-accent-soft);
	}

	.friend-link-avatar {
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 50%;
		overflow: hidden;
		display: grid;
		place-items: center;
		background: var(--color-accent-soft);
		border: 1px solid var(--color-border-strong);
		font-weight: 700;
		color: var(--color-accent);
		flex-shrink: 0;
	}

	.friend-link-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.friend-link-body {
		flex: 1;
		min-width: 0;
		display: grid;
		gap: 0.22rem;
	}

	.friend-link-title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.friend-link-name {
		font-weight: 680;
		font-size: 0.98rem;
		color: var(--color-text);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.friend-link-arrow {
		font-size: 0.85rem;
		color: var(--color-text-muted);
		transition:
			transform var(--transition),
			color var(--transition);
	}

	.friend-link-card:hover .friend-link-name,
	.friend-link-card:hover .friend-link-arrow {
		color: var(--color-accent);
	}

	.friend-link-card:hover .friend-link-arrow {
		transform: translate(2px, -2px);
	}

	.friend-link-host {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--color-text-muted);
	}

	.friend-link-desc {
		margin-top: 0.22rem;
		color: var(--color-text-secondary);
		font-size: 0.86rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.friend-apply-link {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-md);
		width: 100%;
		padding: 1.15rem 1.35rem;
		color: inherit;
	}

	.friend-apply-copy {
		display: grid;
		gap: 0.22rem;
		min-width: 0;
	}

	.friend-apply-copy strong {
		font-size: 0.98rem;
		font-weight: 680;
		color: var(--color-text);
	}

	.friend-apply-copy small {
		font-size: 0.86rem;
		color: var(--color-text-secondary);
		line-height: 1.6;
	}

	.friend-apply-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: var(--radius-pill);
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
		font-size: 1rem;
		color: var(--color-text-secondary);
		transition:
			transform var(--transition),
			background-color var(--transition),
			border-color var(--transition),
			color var(--transition);
	}

	.friend-apply-link:hover .friend-apply-icon {
		transform: translateX(3px);
		background: var(--color-accent-soft);
		border-color: rgba(var(--color-accent-rgb), 0.3);
		color: var(--color-accent);
	}

	@media (max-width: 768px) {
		.friends-hero {
			grid-template-columns: 1fr;
		}

		.friends-hero-count {
			padding-left: 0;
			padding-top: 0.85rem;
			border-left: none;
			border-top: 1px solid var(--color-border);
		}

		.friend-link-list {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (hover: none), (pointer: coarse) {
		.friends-hero {
			transform: none;
		}
	}
</style>
