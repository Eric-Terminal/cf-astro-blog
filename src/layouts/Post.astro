---
import CommentsPanel from "@/components/CommentsPanel.astro";
import { formatDate } from "@/lib/format";
import type { MarkdownTocItem } from "@/lib/security";
import Base from "./Base.astro";

interface Props {
	slug: string;
	title: string;
	description?: string;
	image?: string;
	canonicalUrl?: string;
	publishedAt?: string;
	authorName?: string;
	categoryName?: string;
	articleSidebarAvatarPath?: string;
	articleSidebarName?: string;
	articleSidebarBadge?: string;
	articleSidebarBio?: string;
	cjkCharCount?: number;
	latinWordCount?: number;
	estimatedReadingMinutes?: number;
	backgroundOverride?: {
		imageKey: string;
		opacity: number;
		blur: number;
		scale: number;
		positionX: number;
		positionY: number;
	};
	toc?: MarkdownTocItem[];
}

const {
	slug,
	title,
	description,
	image,
	canonicalUrl,
	publishedAt,
	authorName,
	categoryName,
	articleSidebarAvatarPath,
	articleSidebarName,
	articleSidebarBadge,
	articleSidebarBio,
	cjkCharCount,
	latinWordCount,
	estimatedReadingMinutes,
	backgroundOverride,
	toc,
} = Astro.props;

const formattedDate = publishedAt ? formatDate(publishedAt) : null;
const sidebarName = articleSidebarName?.trim() || authorName?.trim() || "博主";
const sidebarBadge = articleSidebarBadge?.trim() || "文章作者";
const sidebarBio = articleSidebarBio?.trim() || "在这里记录技术、生活和折腾。";
const sidebarAvatarInitial = sidebarName.slice(0, 1).toUpperCase();
const safeCjkCharCount =
	Number.isFinite(cjkCharCount) && Number(cjkCharCount) > 0
		? Math.trunc(Number(cjkCharCount))
		: 0;
const safeLatinWordCount =
	Number.isFinite(latinWordCount) && Number(latinWordCount) > 0
		? Math.trunc(Number(latinWordCount))
		: 0;
const safeEstimatedReadingMinutes =
	Number.isFinite(estimatedReadingMinutes) &&
	Number(estimatedReadingMinutes) > 0
		? Math.trunc(Number(estimatedReadingMinutes))
		: 1;
const countLabelParts: string[] = [];

if (safeCjkCharCount > 0) {
	countLabelParts.push(`${safeCjkCharCount.toLocaleString("zh-CN")} 字`);
}

if (safeLatinWordCount > 0) {
	countLabelParts.push(`${safeLatinWordCount.toLocaleString("en-US")} 词`);
}

const articleLengthLabel =
	countLabelParts.length > 0 ? countLabelParts.join(" / ") : "0 字";
const articleReadingTimeLabel = `约 ${safeEstimatedReadingMinutes.toLocaleString("zh-CN")} 分钟`;
const tocEntries = (toc ?? [])
	.map((item) => ({
		...item,
		level:
			Number.isInteger(item.level) && item.level >= 2 && item.level <= 4
				? item.level
				: 2,
		text: item.text.trim(),
	}))
	.filter((item) => item.id && item.text);
const hasToc = tocEntries.length > 0;
---

<Base
	title={title}
	description={description}
	image={image}
	canonicalUrl={canonicalUrl}
	backgroundOverride={backgroundOverride}
>
	<article class="article-shell">
		<!-- 左侧悬浮辅助轨：满宽方形画框作者名片（有目录时随滚动上推让位，无目录时吸顶常驻陪伴阅读） + 下方光学刻度目录尺 -->
		<aside class:list={["article-sidebar", { "article-sidebar-with-toc": hasToc }]}>
			<section class="article-profile glass-panel">
				<div class="article-profile-avatar-frame">
					{articleSidebarAvatarPath ? (
						<img
							src={articleSidebarAvatarPath}
							alt={`${sidebarName} 的头像`}
							class="article-profile-avatar"
							loading="eager"
							decoding="async"
						/>
					) : (
						<span class="article-profile-avatar-fallback" aria-hidden="true">
							{sidebarAvatarInitial}
						</span>
					)}
				</div>

				<div class="article-profile-identity">
					<span class="article-profile-badge">{sidebarBadge}</span>
					<strong class="article-profile-name">{sidebarName}</strong>
					<p class="article-profile-bio">{sidebarBio}</p>
				</div>

				<div class="article-profile-meta">
					{formattedDate && (
						<div class="article-profile-item">
							<span>发布于</span>
							<strong>
								<time
									class="local-time-pending"
									datetime={publishedAt}
									data-local-time="date"
								>
									{formattedDate}
								</time>
							</strong>
						</div>
					)}
					{categoryName && (
						<div class="article-profile-item">
							<span>所属分类</span>
							<strong>{categoryName}</strong>
						</div>
					)}
					{!hasToc && (
						<div class="article-profile-item">
							<span>篇幅统计</span>
							<strong>{articleLengthLabel} · {articleReadingTimeLabel}</strong>
						</div>
					)}
				</div>
			</section>

			{hasToc && (
				<nav class="article-toc glass-panel" aria-label="文章目录">
					<div class="article-toc-head">
						<span>CONTENTS // {String(tocEntries.length).padStart(2, "0")}</span>
						<button
							type="button"
							class="article-transparency-toggle article-transparency-toggle-compact"
							data-article-transparency-toggle="true"
							aria-pressed="false"
						>
							取消透明度
						</button>
					</div>
					<div class="article-toc-body">
						<ol class="article-toc-list">
							{tocEntries.map((item) => (
								<li class={`article-toc-item level-${item.level}`}>
									<a href={`#${item.id}`} class="article-toc-link" data-toc-id={item.id}>
										<span class="toc-ruler-tick" aria-hidden="true"></span>
										<span class="toc-link-label">{item.text}</span>
									</a>
								</li>
							))}
						</ol>
					</div>
				</nav>
			)}
		</aside>

		<!-- 右侧一体式连贯数字书卷：终结多框拼凑割裂感 -->
		<div class="article-main">
			<div class="article-sheet glass-panel">
				<header class="article-hero">
					<div class="article-hero-tools">
						<nav class="article-breadcrumbs" aria-label="面包屑">
							<a href="/blog" class="article-back">归档</a>
							{categoryName && (
								<>
									<span class="article-crumb-sep" aria-hidden="true">/</span>
									<span class="article-crumb-cat">{categoryName}</span>
								</>
							)}
						</nav>
						<div class="article-hero-stats" aria-label="文章字数与阅读时间">
							<span>{articleLengthLabel}</span>
							<span aria-hidden="true">·</span>
							<span>{articleReadingTimeLabel}</span>
						</div>
						<button
							type="button"
							class="article-transparency-toggle"
							data-article-transparency-toggle="true"
							aria-pressed="false"
						>
							取消透明度
						</button>
					</div>

					<div class="article-hero-body">
						<h1 class="article-title" transition:name={`title-${slug}`}>{title}</h1>
						{description && (
							<p class="article-summary" transition:name={`summary-${slug}`}>
								{description}
							</p>
						)}
						<div class="article-byline" transition:name={`meta-${slug}`}>
							<span class="article-byline-author">{authorName || sidebarName}</span>
							{formattedDate && (
								<>
									<span class="article-byline-dot" aria-hidden="true">·</span>
									<time
										class="article-byline-date local-time-pending"
										datetime={publishedAt}
										data-local-time="date"
									>
										发布于 {formattedDate}
									</time>
								</>
							)}
						</div>
					</div>
				</header>

				<div class="article-body">
					<div class="prose article-prose">
						<slot />
					</div>
				</div>

				<footer class="article-colophon">
					<div class="colophon-line">
						<span class="colophon-mark">END OF DISPATCH</span>
						<a href="/blog" class="colophon-back">浏览更多归档文章 →</a>
					</div>
				</footer>

				<div class="article-comments-card">
					<CommentsPanel />
				</div>
			</div>
		</div>
	</article>
	<script is:inline src="/article-transparency-toggle.js"></script>
	<script is:inline src="/article-sidebar-sticky.js"></script>
	<script is:inline src="/article-toc-highlight.js"></script>
</Base>

<style>
	.article-shell {
		display: grid;
		grid-template-columns: minmax(14.2rem, 16.5rem) minmax(0, 1fr);
		gap: clamp(1.35rem, 2.2vw, 2rem);
		align-items: start;
	}

	.article-main {
		min-width: 0;
	}

	.article-sidebar {
		--article-sidebar-sticky-top: 4.8rem;
		--article-sidebar-gap: 0.85rem;
		--article-profile-height: 0px;
		--article-profile-shift: 0px;
		align-self: stretch;
		display: grid;
		align-content: start;
		grid-auto-rows: max-content;
		gap: var(--article-sidebar-gap);
	}

	.article-profile {
		--glass-panel-opacity: calc(var(--article-panel-opacity, 14) / 100);
		--glass-panel-blur: var(--article-panel-blur, 18px);
		display: grid;
		gap: 0.85rem;
		padding: 1.05rem;
	}

	/* 无目录文章：左侧大头像名片直接吸顶常驻，随正文滚动全程陪伴不留空洞 */
	.article-sidebar:not(.article-sidebar-with-toc) .article-profile {
		position: sticky;
		top: var(--article-sidebar-sticky-top);
	}

	/* 有目录文章：顶部展示完整大头像，向下滚动时平滑上推将置顶位让给目录尺 */
	.article-sidebar-with-toc .article-profile {
		position: sticky;
		top: calc(
			var(--article-sidebar-sticky-top) -
			var(--article-profile-height) -
			var(--article-sidebar-gap)
		);
		transform: translateY(var(--article-profile-shift));
	}

	.article-profile-avatar-frame {
		position: relative;
		width: 100%;
		aspect-ratio: 1 / 1;
		border-radius: var(--radius-inner);
		overflow: hidden;
		background:
			linear-gradient(
				145deg,
				rgba(var(--color-accent-rgb), 0.18),
				rgba(var(--color-accent-rgb), 0.04)
			),
			var(--color-bg-tertiary);
		border: 1px solid var(--color-border-strong);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22);
		display: grid;
		place-items: center;
	}

	.article-profile-avatar {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.article-profile-avatar-fallback {
		font-size: clamp(2.1rem, 1.7rem + 1.6vw, 2.85rem);
		font-weight: 700;
		color: var(--color-accent);
	}

	.article-profile-identity {
		display: grid;
		gap: 0.36rem;
		min-width: 0;
	}

	.article-profile-badge {
		width: fit-content;
		padding: 0.22rem 0.56rem;
		border-radius: var(--radius-pill);
		background: var(--color-accent-soft);
		border: 1px solid rgba(var(--color-accent-rgb), 0.24);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 650;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.article-profile-name {
		font-size: 1.06rem;
		font-weight: 720;
		line-height: 1.28;
		color: var(--color-text);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.article-profile-bio {
		font-size: 0.86rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
		overflow-wrap: anywhere;
	}

	.article-profile-meta {
		display: grid;
		gap: 0.48rem;
		padding-top: 0.72rem;
		border-top: 1px solid var(--color-border);
	}

	.article-profile-item {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.6rem;
		font-size: 0.78rem;
	}

	.article-profile-item > span {
		flex-shrink: 0;
		color: var(--color-text-muted);
	}

	.article-profile-item > strong {
		font-weight: 600;
		color: var(--color-text-secondary);
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	/* 光学刻度目录尺（TOC Minimap Ruler） */
	.article-toc {
		--glass-panel-opacity: calc(var(--article-panel-opacity, 14) / 100);
		--glass-panel-blur: var(--article-panel-blur, 18px);
		display: flex;
		flex-direction: column;
		gap: 0;
		padding: 0.95rem 1rem;
		position: sticky;
		top: var(--article-sidebar-sticky-top);
		max-height: calc(100vh - var(--article-sidebar-sticky-top) - 1.5rem);
	}

	.article-toc-head {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding-bottom: 0.65rem;
		margin-bottom: 0.55rem;
		border-bottom: 1px solid var(--color-border);
	}

	.article-toc-head > span {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		font-weight: 650;
		color: var(--color-text-muted);
	}

	.article-toc-body {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		overflow-x: hidden;
		scrollbar-width: thin;
		scrollbar-color: var(--color-border-strong) transparent;
	}

	.article-toc-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.14rem;
	}

	.article-toc-item {
		margin: 0;
	}

	.article-toc-link {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.28rem 0.35rem;
		border-radius: 6px;
		font-size: 0.82rem;
		line-height: 1.42;
		color: var(--color-text-muted);
		transition:
			color var(--duration-normal) ease,
			background-color var(--duration-normal) ease;
	}

	.toc-ruler-tick {
		width: 8px;
		height: 1.5px;
		flex-shrink: 0;
		border-radius: 999px;
		background: var(--color-border-strong);
		transition:
			width 220ms cubic-bezier(0.22, 1, 0.36, 1),
			background-color 220ms ease,
			box-shadow 220ms ease;
	}

	.article-toc-item.level-3 .toc-ruler-tick {
		width: 5px;
		margin-left: 0.45rem;
	}

	.article-toc-item.level-4 .toc-ruler-tick {
		width: 4px;
		margin-left: 0.85rem;
	}

	.toc-link-label {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.article-toc-link:hover {
		color: var(--color-text);
	}

	.article-toc-link:hover .toc-ruler-tick {
		width: 14px;
		background: var(--color-text-secondary);
	}

	.article-toc-link.active {
		color: var(--color-accent);
		font-weight: 620;
		background: var(--color-accent-soft);
	}

	.article-toc-link.active .toc-ruler-tick {
		width: 20px;
		background: var(--color-accent);
		box-shadow: 0 0 8px rgba(var(--color-accent-rgb), 0.55);
	}

	:global(.article-prose :is(h1, h2, h3, h4, h5, h6)[id]) {
		scroll-margin-top: 5.5rem;
	}

	/* 一体式连贯数字书卷 */
	.article-sheet {
		--glass-panel-opacity: calc(var(--article-panel-opacity, 14) / 100);
		--glass-panel-blur: var(--article-panel-blur, 18px);
		display: grid;
		gap: 0;
	}

	.article-hero {
		display: grid;
		gap: 1.45rem;
		padding: clamp(1.5rem, 1.15rem + 2vw, 2.6rem) clamp(1.5rem, 1.15rem + 2.4vw, 3rem) 1.8rem;
		border-bottom: 1px solid var(--color-border);
	}

	.article-hero-tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.article-breadcrumbs {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.82rem;
	}

	.article-back {
		font-weight: 600;
		color: var(--color-text-secondary);
	}

	.article-back:hover {
		color: var(--color-accent);
	}

	.article-crumb-sep {
		color: var(--color-border-strong);
	}

	.article-crumb-cat {
		font-weight: 600;
		color: var(--color-accent);
	}

	.article-hero-stats {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.42rem;
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.article-transparency-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.3rem 0.66rem;
		border-radius: var(--radius-pill);
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
		color: var(--color-text-secondary);
		font-size: 0.75rem;
		font-weight: 560;
		cursor: pointer;
		transition:
			background-color var(--transition),
			border-color var(--transition),
			color var(--transition),
			transform 100ms ease-out;
	}

	.article-transparency-toggle-compact {
		padding: 0.22rem 0.48rem;
		font-size: 0.68rem;
		white-space: nowrap;
	}

	.article-transparency-toggle:hover,
	.article-transparency-toggle:focus-visible {
		border-color: rgba(var(--color-accent-rgb), 0.35);
		background: var(--color-accent-soft);
		color: var(--color-accent);
		outline: none;
	}

	.article-transparency-toggle:active {
		transform: scale(0.95);
	}

	.article-hero-body {
		max-width: var(--max-width-prose);
		margin-inline: auto;
		width: 100%;
		display: grid;
		gap: 0.9rem;
	}

	.article-title {
		font-family: var(--font-serif-body);
		font-size: clamp(1.9rem, 1.5rem + 1.85vw, 2.9rem);
		font-weight: 700;
		line-height: 1.22;
		letter-spacing: -0.024em;
		color: var(--color-text);
	}

	.article-summary {
		font-size: 1.02rem;
		line-height: 1.75;
		color: var(--color-text-secondary);
	}

	.article-byline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		padding-top: 0.25rem;
		font-size: 0.83rem;
		color: var(--color-text-muted);
	}

	.article-byline-author {
		font-weight: 620;
		color: var(--color-text);
	}

	.article-byline-date {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-variant-numeric: tabular-nums;
	}

	.article-body {
		padding: clamp(1.75rem, 1.25rem + 2vw, 2.75rem) clamp(1.5rem, 1.15rem + 2.4vw, 3rem);
		width: 100%;
	}

	.article-prose {
		margin-inline: auto;
	}

	.article-colophon {
		padding: 0 clamp(1.5rem, 1.15rem + 2.4vw, 3rem);
	}

	.colophon-line {
		max-width: var(--max-width-prose);
		margin-inline: auto;
		padding-block: 1.15rem;
		border-top: 1px dashed var(--color-border-strong);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.colophon-mark {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
	}

	.colophon-back {
		font-size: 0.84rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.article-comments-card {
		border-top: 1px solid var(--color-border);
		padding: 0.45rem clamp(0.65rem, 1vw, 1.5rem) 0.65rem;
	}

	:global(html.article-opaque-mode) .article-shell .glass-panel {
		background: rgba(var(--card-surface-rgb), 0.97);
		border-color: var(--color-border-strong);
	}

	:global(html.article-opaque-mode) .article-shell .glass-panel::after {
		background: rgba(var(--card-surface-rgb), 0.98);
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	:global(html.article-opaque-mode) .article-shell .glass-panel::before {
		opacity: 0;
	}

	:global(.article-comments-card .comments-panel) {
		border: none;
		background: transparent;
		border-radius: 0;
		overflow: visible;
	}

	:global(html.article-opaque-mode .article-comments-card .comments-panel) {
		background: transparent;
	}

	@media (max-width: 1024px) {
		.article-shell {
			grid-template-columns: 1fr;
		}

		.article-sidebar {
			align-self: start;
			position: static;
			top: auto;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.article-sidebar:not(.article-sidebar-with-toc) {
			grid-template-columns: 1fr;
		}

		.article-profile,
		.article-sidebar:not(.article-sidebar-with-toc) .article-profile,
		.article-sidebar-with-toc .article-profile,
		.article-toc {
			position: static;
			top: auto;
			max-height: none;
			transform: none;
