---
import CommentsPanel from "@/components/CommentsPanel.astro";
import { formatDate } from "@/lib/format";
import type { MarkdownTocItem } from "@/lib/security";
import Base from "./Base.astro";

interface Props {
	slug: string;
	title: string;
	description?: string;
	image?: string;
	canonicalUrl?: string;
	publishedAt?: string;
	authorName?: string;
	categoryName?: string;
	articleSidebarAvatarPath?: string;
	articleSidebarName?: string;
	articleSidebarBadge?: string;
	articleSidebarBio?: string;
	cjkCharCount?: number;
	latinWordCount?: number;
	estimatedReadingMinutes?: number;
	backgroundOverride?: {
		imageKey: string;
		opacity: number;
		blur: number;
		scale: number;
		positionX: number;
		positionY: number;
	};
	toc?: MarkdownTocItem[];
}

const {
	slug,
	title,
	description,
	image,
	canonicalUrl,
	publishedAt,
	authorName,
	categoryName,
	articleSidebarAvatarPath,
	articleSidebarName,
	articleSidebarBadge,
	articleSidebarBio,
	cjkCharCount,
	latinWordCount,
	estimatedReadingMinutes,
	backgroundOverride,
	toc,
} = Astro.props;

const formattedDate = publishedAt ? formatDate(publishedAt) : null;
const sidebarName = articleSidebarName?.trim() || authorName?.trim() || "博主";
const sidebarBadge = articleSidebarBadge?.trim() || "文章作者";
const sidebarBio = articleSidebarBio?.trim() || "在这里记录技术、生活和折腾。";
const sidebarAvatarInitial = sidebarName.slice(0, 1).toUpperCase();
const safeCjkCharCount =
	Number.isFinite(cjkCharCount) && Number(cjkCharCount) > 0
		? Math.trunc(Number(cjkCharCount))
		: 0;
const safeLatinWordCount =
	Number.isFinite(latinWordCount) && Number(latinWordCount) > 0
		? Math.trunc(Number(latinWordCount))
		: 0;
const safeEstimatedReadingMinutes =
	Number.isFinite(estimatedReadingMinutes) &&
	Number(estimatedReadingMinutes) > 0
		? Math.trunc(Number(estimatedReadingMinutes))
		: 1;
const countLabelParts: string[] = [];

if (safeCjkCharCount > 0) {
	countLabelParts.push(`${safeCjkCharCount.toLocaleString("zh-CN")} 字`);
}

if (safeLatinWordCount > 0) {
	countLabelParts.push(`${safeLatinWordCount.toLocaleString("en-US")} 词`);
}

const articleLengthLabel =
	countLabelParts.length > 0 ? countLabelParts.join(" / ") : "0 字";
const articleReadingTimeLabel = `约 ${safeEstimatedReadingMinutes.toLocaleString("zh-CN")} 分钟`;
const tocEntries = (toc ?? [])
	.map((item) => ({
		...item,
		level:
			Number.isInteger(item.level) && item.level >= 2 && item.level <= 4
				? item.level
				: 2,
		text: item.text.trim(),
	}))
	.filter((item) => item.id && item.text);
const hasToc = tocEntries.length > 0;
---

<Base
	title={title}
	description={description}
	image={image}
	canonicalUrl={canonicalUrl}
	backgroundOverride={backgroundOverride}
>
	<article class="article-shell">
		<aside class:list={["article-sidebar", { "article-sidebar-with-toc": hasToc }]}>
			<section class="article-profile glass-panel">
				<div class="article-profile-head">
					<div class="article-profile-avatar-frame">
						{articleSidebarAvatarPath ? (
							<img
								src={articleSidebarAvatarPath}
								alt={`${sidebarName} 的头像`}
								class="article-profile-avatar"
								loading="lazy"
								decoding="async"
							/>
						) : (
							<span class="article-profile-avatar-fallback" aria-hidden="true">
								{sidebarAvatarInitial}
							</span>
						)}
					</div>
					<div class="article-profile-identity">
						<span class="article-profile-badge">{sidebarBadge}</span>
						<strong class="article-profile-name">{sidebarName}</strong>
					</div>
				</div>
				<p class="article-profile-bio">{sidebarBio}</p>
				{(formattedDate || categoryName) && (
					<div class="article-profile-meta">
						{formattedDate && (
							<div class="article-profile-item">
								<span>发布于</span>
								<strong>
									<time
										class="local-time-pending"
										datetime={publishedAt}
										data-local-time="date"
									>
										{formattedDate}
									</time>
								</strong>
							</div>
						)}
						{categoryName && (
							<div class="article-profile-item">
								<span>分类</span>
								<strong>{categoryName}</strong>
							</div>
						)}
					</div>
				)}
			</section>
			{hasToc && (
				<nav class="article-toc glass-panel" aria-label="文章目录">
					<div class="article-toc-head">
						<span>目录导航</span>
						<button
							type="button"
							class="article-transparency-toggle article-transparency-toggle-compact"
							data-article-transparency-toggle="true"
							aria-pressed="false"
						>
							取消透明度
						</button>
					</div>
					<div class="article-toc-body">
						<ol class="article-toc-list">
							{tocEntries.map((item) => (
								<li class={`article-toc-item level-${item.level}`}>
									<a href={`#${item.id}`} class="article-toc-link" data-toc-id={item.id}>
										{item.text}
									</a>
								</li>
							))}
						</ol>
					</div>
				</nav>
			)}
		</aside>

		<div class="article-main">
			<header class="article-hero glass-panel">
				<div class="article-hero-tools">
					<a href="/blog" class="article-back">← 返回归档</a>
					<div class="article-hero-stats" aria-label="文章字数与阅读时间">
						<span class="article-hero-stat">{articleLengthLabel}</span>
						<span class="article-hero-sep" aria-hidden="true">·</span>
						<span class="article-hero-stat">{articleReadingTimeLabel}</span>
					</div>
					<button
						type="button"
						class="article-transparency-toggle"
						data-article-transparency-toggle="true"
						aria-pressed="false"
					>
						取消透明度
					</button>
				</div>

				<div class="article-hero-body">
					<div class="article-meta-line" transition:name={`meta-${slug}`}>
						{categoryName && <span class="article-category">{categoryName}</span>}
						{formattedDate && (
							<time
								class="article-date local-time-pending"
								datetime={publishedAt}
								data-local-time="date"
							>
								{formattedDate}
							</time>
						)}
						{authorName && <span class="article-author">{authorName}</span>}
					</div>
					<h1 class="article-title" transition:name={`title-${slug}`}>{title}</h1>
					{description && (
						<p class="article-summary" transition:name={`summary-${slug}`}>
							{description}
						</p>
					)}
				</div>
			</header>

			<div class="article-body glass-panel">
				<div class="prose article-prose">
					<slot />
				</div>
			</div>

			<div class="article-comments-card glass-panel">
				<CommentsPanel />
			</div>
		</div>
	</article>
	<script is:inline src="/article-transparency-toggle.js"></script>
	<script is:inline src="/article-sidebar-sticky.js"></script>
	<script is:inline src="/article-toc-highlight.js"></script>
</Base>

<style>
	.article-shell {
		display: grid;
		grid-template-columns: minmax(14rem, 16.5rem) minmax(0, 1fr);
		gap: clamp(1.4rem, 2.4vw, 2.2rem);
		align-items: start;
	}

	.article-main {
		display: grid;
		gap: 1.25rem;
		min-width: 0;
	}

	.article-sidebar {
		--article-sidebar-sticky-top: 4.8rem;
		--article-sidebar-gap: 0.85rem;
		--article-profile-height: 0px;
		--article-profile-shift: 0px;
		align-self: stretch;
		display: grid;
		align-content: start;
		grid-auto-rows: max-content;
		gap: var(--article-sidebar-gap);
	}

	.article-profile {
		display: grid;
		gap: 0.85rem;
		padding: 1.1rem;
	}

	.article-sidebar-with-toc .article-profile {
		position: sticky;
		top: calc(
			var(--article-sidebar-sticky-top) -
			var(--article-profile-height) -
			var(--article-sidebar-gap)
		);
		transform: translateY(var(--article-profile-shift));
	}

	.article-profile-head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.article-profile-avatar-frame {
		width: 3rem;
		height: 3rem;
		flex-shrink: 0;
		border-radius: 50%;
		overflow: hidden;
		background: var(--color-accent-soft);
		border: 1px solid var(--color-border-strong);
		display: grid;
		place-items: center;
	}

	.article-profile-avatar {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.article-profile-avatar-fallback {
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--color-accent);
	}

	.article-profile-identity {
		display: grid;
		gap: 0.15rem;
		min-width: 0;
	}

	.article-profile-badge {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.article-profile-name {
		font-size: 0.98rem;
		font-weight: 680;
		line-height: 1.25;
		color: var(--color-text);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.article-profile-bio {
		font-size: 0.86rem;
		line-height: 1.68;
		color: var(--color-text-secondary);
	}

	.article-profile-meta {
		display: grid;
		gap: 0.45rem;
		padding-top: 0.7rem;
		border-top: 1px solid var(--color-border);
	}

	.article-profile-item {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		font-size: 0.8rem;
	}

	.article-profile-item span {
		color: var(--color-text-muted);
	}

	.article-profile-item strong {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 560;
		color: var(--color-text);
		font-variant-numeric: tabular-nums;
	}

	.article-toc {
		display: flex;
		flex-direction: column;
		gap: 0;
		padding: 1rem 1.05rem;
		position: sticky;
		top: var(--article-sidebar-sticky-top);
		max-height: calc(100vh - var(--article-sidebar-sticky-top) - 1.5rem);
	}

	.article-toc-head {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding-bottom: 0.65rem;
		margin-bottom: 0.55rem;
		border-bottom: 1px solid var(--color-border);
	}

	.article-toc-head > span {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--color-text-muted);
	}

	.article-toc-body {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		overflow-x: hidden;
		scrollbar-width: thin;
		scrollbar-color: var(--color-border-strong) transparent;
	}

	.article-toc-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.16rem;
		border-left: 1px solid var(--color-border);
	}

	.article-toc-item {
		margin: 0;
	}

	.article-toc-item.level-3 .article-toc-link {
		padding-left: 1.25rem;
		font-size: 0.81rem;
	}

	.article-toc-item.level-4 .article-toc-link {
		padding-left: 1.85rem;
		font-size: 0.78rem;
	}

	.article-toc-link {
		display: block;
		margin-left: -1px;
		padding: 0.3rem 0.55rem 0.3rem 0.75rem;
		border-left: 2px solid transparent;
		font-size: 0.84rem;
		line-height: 1.45;
		color: var(--color-text-muted);
		transition:
			color var(--duration-normal) ease,
			border-color var(--duration-normal) ease;
	}

	.article-toc-link:hover {
		color: var(--color-text);
		border-left-color: var(--color-border-strong);
	}

	.article-toc-link.active {
		color: var(--color-accent);
		border-left-color: var(--color-accent);
		font-weight: 600;
	}

	:global(.article-prose :is(h1, h2, h3, h4, h5, h6)[id]) {
		scroll-margin-top: 5.5rem;
	}

	.article-hero {
		display: grid;
		gap: 1.25rem;
		padding: clamp(1.35rem, 1rem + 1.8vw, 2.25rem);
	}

	.article-hero-tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
		padding-bottom: 0.95rem;
		border-bottom: 1px solid var(--color-border);
	}

	.article-back {
		font-size: 0.84rem;
		font-weight: 560;
		color: var(--color-text-secondary);
	}

	.article-back:hover {
		color: var(--color-accent);
	}

	.article-hero-stats {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.42rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.article-hero-sep {
		opacity: 0.6;
	}

	.article-transparency-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.32rem 0.68rem;
		border-radius: var(--radius-pill);
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
		color: var(--color-text-secondary);
		font-size: 0.76rem;
		font-weight: 550;
		cursor: pointer;
		transition:
			background-color var(--transition),
			border-color var(--transition),
			color var(--transition),
			transform 100ms ease-out;
	}

	.article-transparency-toggle-compact {
		padding: 0.24rem 0.52rem;
		font-size: 0.7rem;
		white-space: nowrap;
	}

	.article-transparency-toggle:hover,
	.article-transparency-toggle:focus-visible {
		border-color: rgba(var(--color-accent-rgb), 0.32);
		background: var(--color-accent-soft);
		color: var(--color-accent);
		outline: none;
	}

	.article-transparency-toggle:active {
		transform: scale(0.95);
	}

	.article-hero-body {
		display: grid;
		gap: 0.85rem;
	}

	.article-meta-line {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
		font-size: 0.82rem;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.article-category {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.article-category::before {
		content: "";
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: currentColor;
	}

	.article-date {
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}

	.article-category + .article-date::before,
	.article-date + .article-author::before {
		content: "·";
		margin-right: 0.65rem;
		color: var(--color-border-strong);
	}

	.article-title {
		font-family: var(--font-sans);
		font-size: clamp(1.85rem, 1.45rem + 1.8vw, 2.85rem);
		font-weight: 760;
		line-height: 1.2;
		letter-spacing: -0.028em;
		color: var(--color-text);
	}

	.article-summary {
		max-width: 44rem;
		font-size: 1.02rem;
		line-height: 1.78;
		color: var(--color-text-secondary);
	}

	.article-body {
		padding: clamp(1.5rem, 1.1rem + 2vw, 2.6rem);
		width: 100%;
	}

	.article-prose {
		margin-inline: auto;
	}

	/* 专注模式（取消透明度）：切换为高对比实底阅读面，屏蔽复杂壁纸干扰 */
	:global(html.article-opaque-mode) .article-shell .glass-panel {
		background: rgba(var(--card-surface-rgb), 0.97);
		border-color: var(--color-border-strong);
	}

	:global(html.article-opaque-mode) .article-shell .glass-panel::after {
		background: rgba(var(--card-surface-rgb), 0.98);
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	:global(html.article-opaque-mode) .article-shell .glass-panel::before {
		opacity: 0;
	}

	:global(.article-comments-card .comments-panel) {
		border: none;
		background: transparent;
		border-radius: 0;
		overflow: visible;
	}

	:global(html.article-opaque-mode .article-comments-card .comments-panel) {
		background: transparent;
	}

	@media (max-width: 1024px) {
		.article-shell {
			grid-template-columns: 1fr;
		}

		.article-sidebar {
			align-self: start;
			position: static;
			top: auto;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.article-profile,
		.article-toc {
			position: static;
			top: auto;
			max-height: none;
		}

		.article-toc-body {
			overflow-y: visible;
		}
	}

	@media (max-width: 900px), (orientation: portrait) and (max-width: 1180px) {
		.article-shell {
			grid-template-columns: 1fr;
		}

		.article-sidebar {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.article-hero-stats {
			margin-left: 0;
			order: 3;
			width: 100%;
		}

		.article-transparency-toggle {
			margin-left: auto;
		}
	}
</style>
