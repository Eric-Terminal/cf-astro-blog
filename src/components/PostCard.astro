---
import "@/styles/post-card.css";
import { formatDate } from "@/lib/format";
import { encodeRouteParam } from "@/lib/security";
import { siteConfig } from "@/lib/types";

interface Props {
	title: string;
	slug: string;
	excerpt?: string | null;
	publishedAt?: string | null;
	categoryName?: string | null;
	authorName?: string | null;
	featuredImageKey?: string | null;
	featuredImageAlt?: string | null;
	cjkCharCount?: number;
	latinWordCount?: number;
	estimatedReadingMinutes?: number;
	variant?: "featured" | "regular";
	indexNumber?: number;
	tilt?: boolean;
}

const {
	title,
	slug,
	excerpt,
	publishedAt,
	categoryName,
	authorName,
	featuredImageKey,
	featuredImageAlt,
	cjkCharCount,
	latinWordCount,
	estimatedReadingMinutes,
	variant = "regular",
	indexNumber,
	tilt = true,
} = Astro.props;

const formattedDate = publishedAt ? formatDate(publishedAt) : null;
const coverImageUrl = featuredImageKey ? `/media/${featuredImageKey}` : null;
const coverImageAlt = featuredImageAlt?.trim() || `${title} 的封面图`;
const hasCover = Boolean(coverImageUrl);
const displaySerial =
	typeof indexNumber === "number" && indexNumber > 0
		? String(indexNumber).padStart(2, "0")
		: null;
const cardClassName = [
	"post-card",
	"glass-panel",
	variant === "featured" ? "post-card-featured" : "post-card-regular",
	hasCover ? "post-card-has-cover" : "post-card-no-cover",
].join(" ");
const safeCjkCharCount =
	Number.isFinite(cjkCharCount) && Number(cjkCharCount) > 0
		? Math.trunc(Number(cjkCharCount))
		: 0;
const safeLatinWordCount =
	Number.isFinite(latinWordCount) && Number(latinWordCount) > 0
		? Math.trunc(Number(latinWordCount))
		: 0;
const safeEstimatedReadingMinutes =
	Number.isFinite(estimatedReadingMinutes) &&
	Number(estimatedReadingMinutes) > 0
		? Math.trunc(Number(estimatedReadingMinutes))
		: 1;
const countLabelParts: string[] = [];

if (safeCjkCharCount > 0) {
	countLabelParts.push(`${safeCjkCharCount.toLocaleString("zh-CN")} 字`);
}

if (safeLatinWordCount > 0) {
	countLabelParts.push(`${safeLatinWordCount.toLocaleString("en-US")} 词`);
}

const articleLengthLabel =
	countLabelParts.length > 0 ? countLabelParts.join(" / ") : "0 字";
const articleReadingTimeLabel = `约 ${safeEstimatedReadingMinutes.toLocaleString("zh-CN")} 分钟`;
const encodedSlug = encodeRouteParam(slug);
---

<article
	class={cardClassName}
	data-tilt-card={tilt ? "" : undefined}
	data-tilt-scale={tilt ? (variant === "featured" ? "0.42" : "0.48") : undefined}
	data-tilt-shift-scale={tilt ? "0.65" : undefined}
>
	{hasCover && (
		<a
			href={`/blog/${encodedSlug}`}
			class="post-card-cover"
			tabindex="-1"
			aria-hidden="true"
			data-astro-prefetch="hover"
		>
			<img src={coverImageUrl} alt={coverImageAlt} loading="lazy" decoding="async" />
			{displaySerial && <span class="post-card-cover-serial">{displaySerial}</span>}
		</a>
	)}
	<div class="post-card-content">
		<div class="post-card-top">
			<div class="post-card-eyebrow" transition:name={`meta-${slug}`}>
				<div class="post-card-taxonomy">
					{!hasCover && displaySerial && (
						<span class="post-card-serial" aria-hidden="true">{displaySerial}</span>
					)}
					{categoryName && <span class="post-card-category">{categoryName}</span>}
					{formattedDate && (
						<time
							class="post-card-date local-time-pending"
							datetime={publishedAt ?? undefined}
							data-local-time="date"
						>
							{formattedDate}
						</time>
					)}
				</div>
				<div class="post-card-stats" aria-label="字数与预计阅读时间">
					<span>{articleLengthLabel}</span>
					<span class="post-card-dot" aria-hidden="true">·</span>
					<span>{articleReadingTimeLabel}</span>
				</div>
			</div>
			<a href={`/blog/${encodedSlug}`} class="post-card-link" data-astro-prefetch="hover">
				<h3 class="post-card-title" transition:name={`title-${slug}`}>{title}</h3>
			</a>
		</div>
		{excerpt && (
			<p class="post-card-excerpt" transition:name={`summary-${slug}`}>
				{excerpt}
			</p>
		)}
		<div class="post-card-meta">
			<span class="post-card-author">{authorName || siteConfig.author}</span>
			<span class="post-card-orb" aria-hidden="true">
				<span class="post-card-readmore-text">阅读</span>
				<span class="post-card-arrow">↗</span>
			</span>
		</div>
	</div>
</article>
