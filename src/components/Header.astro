---
import { buildSiteNavLinks, type SiteAppearance } from "@/lib/site-appearance";
import { siteConfig } from "@/lib/types";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	siteAppearance: SiteAppearance;
}

const currentPath = Astro.url.pathname;
const { siteAppearance }: Props = Astro.props;
const navLinks = buildSiteNavLinks(siteAppearance);

function isInternalHref(href: string) {
	return href.startsWith("/") && !href.startsWith("//");
}

function isLinkActive(href: string) {
	if (!isInternalHref(href)) {
		return false;
	}

	if (href === "/") {
		return currentPath === "/";
	}

	return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
	<nav class="site-nav" aria-label="主导航" transition:persist>
		<div class="site-nav-shell-scroll">
			<div class="site-nav-shell">
				<div class="site-brand">
					<a href="/api/auth/login" class="site-brand-mark-link" aria-label="打开站点入口">
						<span class="site-brand-mark" aria-hidden="true">
							<img
								src="https://assets.ericterminal.com/logo-transparent.png"
								alt=""
								loading="eager"
								decoding="async"
							/>
						</span>
					</a>
					<a href="/" class="site-brand-copy-link" aria-label={siteConfig.name}>
						<span class="site-brand-copy">
							<strong>{siteConfig.name}</strong>
							<small>{siteAppearance.headerSubtitle}</small>
						</span>
					</a>
				</div>

				<!-- 文章阅读态专属灵动岛播报舱：下滑阅读时展示当前章节与进度环，悬停灵动岛时自动翻转回完整导航 -->
				<div class="nav-reading-hud" data-nav-reading-hud aria-hidden="true">
					<span class="nav-hud-pulse"></span>
					<span class="nav-hud-chapter" data-nav-reading-chapter>正在阅读</span>
				</div>

				<ul class="nav-links" data-nav-links>
					<span class="nav-glide-pill" data-nav-indicator aria-hidden="true"></span>
					{
						navLinks.map((item) => (
							<li>
								<a
									href={item.href}
									class:list={["nav-link", { active: isLinkActive(item.href) }]}
									data-astro-prefetch={isInternalHref(item.href) ? "load" : undefined}
									target={isInternalHref(item.href) ? undefined : "_blank"}
									rel={isInternalHref(item.href) ? undefined : "noopener noreferrer"}
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>

				<div class="nav-actions">
					<button
						type="button"
						class="nav-cmd-trigger"
						data-command-trigger
						aria-label="打开快捷检索与命令面板"
						title="全站检索与快捷命令 (⌘K)"
					>
						<svg
							width="14"
							height="14"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.1"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="11" cy="11" r="8"></circle>
							<path d="m21 21-4.3-4.3"></path>
						</svg>
						<kbd>⌘K</kbd>
					</button>
					<button
						type="button"
						class="nav-reading-pill"
						data-nav-back-top
						aria-label="回到文章顶部"
						title="点击回到顶部"
						hidden
					>
						<svg class="nav-progress-ring" width="16" height="16" viewBox="0 0 20 20" aria-hidden="true">
							<circle class="nav-ring-track" cx="10" cy="10" r="7.5" fill="none" stroke-width="2.2" />
							<circle
								class="nav-ring-fill"
								cx="10"
								cy="10"
								r="7.5"
								fill="none"
								stroke-width="2.2"
								stroke-dasharray="47.12"
								style="stroke-dashoffset: calc(47.12 * (1 - var(--nav-reading-progress, 0)));"
							/>
						</svg>
						<span class="nav-reading-percent" data-nav-reading-percent>0%</span>
						<span class="nav-reading-up" aria-hidden="true">↑</span>
					</button>
					<ThemeToggle />
				</div>
			</div>
			<span class="nav-reading-track" aria-hidden="true">
				<span class="nav-reading-bar" data-nav-reading-bar></span>
			</span>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 30;
		padding-inline: 0;
		pointer-events: none;
		transition:
			top var(--nav-motion-main),
			padding-inline var(--nav-motion-main);
	}

	.site-nav {
		position: relative;
		width: 100%;
		pointer-events: none;
		isolation: isolate;
		contain: paint;
	}

	/* 外壳动画与内部布局分离，确保顶栏与灵动岛变形全程 60fps 无文字重排抖动 */
	.site-nav::before {
		content: "";
		position: absolute;
		inset: 0;
		border: 1px solid transparent;
		border-bottom-color: var(--color-border);
		border-radius: 0;
		background: var(--nav-shell-open-surface);
		box-shadow: var(--nav-shell-open-shadow);
		backdrop-filter: blur(var(--nav-shell-blur-effective, 14px)) saturate(150%);
		-webkit-backdrop-filter: blur(var(--nav-shell-blur-effective, 14px))
			saturate(150%);
		transform-origin: top center;
		transform: translate3d(0, 0, 0);
		backface-visibility: hidden;
		will-change: inset, border-radius, transform, box-shadow;
		transition:
			inset var(--nav-motion-main),
			border-radius var(--nav-motion-main),
			background-color var(--nav-motion-surface),
			border-color var(--nav-motion-surface),
			box-shadow var(--nav-motion-surface),
			transform var(--nav-motion-transform);
	}

	.site-nav-shell-scroll {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 100vw;
		margin-inline: 0;
		border-radius: 0;
		overflow-x: auto;
		overflow-y: hidden;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		pointer-events: auto;
		will-change: width, margin-inline, border-radius, transform;
		transition:
			width var(--nav-motion-main),
			margin-inline var(--nav-motion-main),
			border-radius var(--nav-motion-main),
			transform var(--nav-motion-transform);
	}

	.site-nav-shell-scroll::-webkit-scrollbar {
		display: none;
	}

	.site-nav-shell {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.85rem;
		width: min(100%, var(--max-width));
		min-width: max-content;
		margin-inline: auto;
		padding:
			0.75rem
			calc(1.25rem + env(safe-area-inset-right))
			0.75rem
			calc(1.25rem + env(safe-area-inset-left));
		transform-origin: top center;
		transform: translate3d(0, 0, 0) scale(1);
		transition:
			gap var(--nav-motion-main),
			padding var(--nav-motion-main),
			transform var(--nav-motion-transform);
	}

	.site-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.68rem;
		flex: 0 0 auto;
	}

	.site-brand-mark-link,
	.site-brand-copy-link {
		display: inline-flex;
		align-items: center;
		min-width: 0;
		color: inherit;
	}

	.site-brand-mark-link {
		border-radius: 10px;
	}

	.site-brand-mark-link:active {
		transform: scale(0.95);
	}

	.site-brand-mark {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.15rem;
		height: 2.15rem;
		border-radius: 10px;
		padding: 0.22rem;
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
		box-shadow: inset 0 1px 0 var(--glass-highlight);
		transition:
			width var(--nav-motion-main),
			height var(--nav-motion-main),
			border-radius var(--nav-motion-main),
			border-color var(--transition);
	}

	.site-brand-mark-link:hover .site-brand-mark {
		border-color: rgba(var(--color-accent-rgb), 0.38);
	}

	.site-brand-mark img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.site-brand-copy {
		display: grid;
		gap: 0.08rem;
		min-width: 0;
		transition:
			opacity 240ms ease,
			transform var(--nav-motion-main);
	}

	.site-brand-copy strong {
		display: block;
		max-width: 15rem;
		font-size: 0.94rem;
		font-weight: 680;
		line-height: 1.25;
		color: var(--color-text);
		letter-spacing: -0.018em;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.site-brand-copy small {
		display: block;
		max-height: 1.2rem;
		color: var(--color-text-muted);
		font-size: 0.73rem;
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		transform-origin: left top;
		transition:
			opacity 220ms ease,
			max-height var(--nav-motion-main),
			transform var(--nav-motion-main);
	}

	/* 多模态章节播报舱（仅在文章阅读成岛且鼠标未悬停展开时浮现） */
	.nav-reading-hud {
		display: none;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		max-width: 22rem;
		margin-right: auto;
		animation: hud-slot-in 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.nav-hud-pulse {
		width: 6px;
		height: 6px;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 0 3px var(--color-accent-soft);
	}

	.nav-hud-chapter {
		font-size: 0.84rem;
		font-weight: 600;
		color: var(--color-text);
		letter-spacing: -0.01em;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@keyframes hud-slot-in {
		from {
			opacity: 0;
			transform: translate3d(0, 7px, 0);
		}
		to {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
	}

	.nav-links,
	.nav-actions {
		display: inline-flex;
		align-items: center;
		list-style: none;
		transform: translate3d(0, 0, 0);
		transition:
			opacity 220ms ease,
			gap var(--nav-motion-main),
			transform var(--nav-motion-surface);
	}

	.nav-links {
		position: relative;
		margin-left: auto;
		flex-wrap: nowrap;
		white-space: nowrap;
		gap: 0.16rem;
		padding: 0.2rem;
		border-radius: var(--radius-pill);
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
	}

	/* 物理跟随滑动胶囊背景：随鼠标悬停或激活路由在链接间丝滑游走 */
	.nav-glide-pill {
		position: absolute;
		top: 0.2rem;
		bottom: 0.2rem;
		left: 0;
		width: var(--glide-w, 0px);
		border-radius: var(--radius-pill);
		background: var(--color-surface-elevated);
		border: 1px solid var(--color-border);
		box-shadow:
			0 2px 8px -2px var(--color-shadow),
			inset 0 1px 0 var(--glass-highlight);
		opacity: var(--glide-opacity, 0);
		transform: translate3d(var(--glide-x, 0px), 0, 0);
		pointer-events: none;
		transition:
			transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
			width 320ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 180ms ease;
	}

	.nav-link {
		position: relative;
		z-index: 1;
		display: inline-block;
		color: var(--color-text-secondary);
		font-size: 0.85rem;
		font-weight: 540;
		line-height: 1.2;
		padding: 0.42rem 0.82rem;
		border-radius: var(--radius-pill);
		transition:
			color var(--transition),
			padding var(--nav-motion-main),
			transform 120ms ease-out;
	}

	.nav-link:hover,
	.nav-link.active {
		color: var(--color-text);
	}

	.nav-link.active {
		font-weight: 640;
	}

	.nav-link:active {
		transform: scale(0.96);
	}

	.nav-actions {
		flex: 0 0 auto;
		gap: 0.42rem;
		min-width: max-content;
	}

	.nav-cmd-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.36rem;
		height: 2.15rem;
		padding: 0 0.65rem;
		border-radius: var(--radius-pill);
		border: 1px solid var(--color-border);
		background: var(--color-bg-tertiary);
		color: var(--color-text-secondary);
		box-shadow: inset 0 1px 0 var(--glass-highlight);
		cursor: pointer;
		transition:
			color var(--transition),
			border-color var(--transition),
			background-color var(--transition),
			transform 120ms ease-out;
	}

	.nav-cmd-trigger:hover {
		color: var(--color-text);
		border-color: var(--color-border-strong);
		background: var(--color-accent-soft);
	}

	.nav-cmd-trigger:active {
		transform: scale(0.95);
	}

	.nav-cmd-trigger kbd {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		color: var(--color-text-muted);
	}

	/* 环形进度 + 一键回顶胶囊 */
	.nav-reading-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.32rem;
		height: 2rem;
		padding: 0 0.62rem 0 0.42rem;
		border-radius: var(--radius-pill);
		border: 1px solid rgba(var(--color-accent-rgb), 0.24);
		background: var(--color-accent-soft);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.73rem;
		font-weight: 650;
		font-variant-numeric: tabular-nums;
		line-height: 1;
		cursor: pointer;
		opacity: 0;
		transform: scale(0.92);
		pointer-events: none;
		transition:
			opacity 220ms ease,
			transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
			background-color var(--transition),
			border-color var(--transition);
	}

	.nav-reading-pill[hidden] {
		display: none;
	}

	.nav-reading-pill:hover {
		background: rgba(var(--color-accent-rgb), 0.18);
		border-color: rgba(var(--color-accent-rgb), 0.42);
	}

	.nav-reading-pill:active {
		transform: scale(0.94);
	}

	.nav-progress-ring {
		transform: rotate(-90deg);
		flex-shrink: 0;
	}

	.nav-ring-track {
		stroke: rgba(var(--color-accent-rgb), 0.2);
	}

	.nav-ring-fill {
		stroke: var(--color-accent);
		stroke-linecap: round;
		transition: stroke-dashoffset 140ms linear;
	}

	.nav-reading-up {
		font-size: 0.76rem;
		transition: transform var(--transition);
	}

	.nav-reading-pill:hover .nav-reading-up {
		transform: translateY(-1.5px);
	}

	.nav-reading-track {
		position: absolute;
		left: 1.35rem;
		right: 1.35rem;
		bottom: 0;
		height: 2px;
		border-radius: var(--radius-pill);
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
		transition: opacity 240ms ease;
	}

	.nav-reading-bar {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--color-accent);
		transform-origin: left center;
		transform: scaleX(var(--nav-reading-progress, 0));
		will-change: transform;
	}

	/* === 下滑凝聚为悬浮灵动岛（data-nav-condensed） === */
	:global(html[data-nav-condensed]) .site-header {
		top: 0.65rem;
		padding-inline: 0.75rem;
	}

	:global(html[data-nav-condensed]) .site-nav::before {
		inset-inline: var(
			--nav-shell-condensed-computed-inset,
			max(
				var(--nav-shell-condensed-inset-desktop),
				calc((100% - var(--nav-shell-max-width)) / 2)
			)
		);
		border: 1px solid var(--glass-border);
		border-radius: var(--nav-shell-condensed-radius);
		background: var(--nav-shell-condensed-surface);
		box-shadow: var(--nav-shell-condensed-shadow);
		transform: translate3d(0, 0, 0) scale(var(--nav-shell-condensed-scale));
	}

	:global(html[data-nav-condensed]) .site-nav-shell-scroll {
		width: calc(
			100% -
				2 *
				var(
					--nav-shell-condensed-computed-inset,
					max(
						var(--nav-shell-condensed-inset-desktop),
						calc((100% - var(--nav-shell-max-width)) / 2)
					)
				)
		);
		margin-inline: var(
			--nav-shell-condensed-computed-inset,
			max(
				var(--nav-shell-condensed-inset-desktop),
				calc((100% - var(--nav-shell-max-width)) / 2)
			)
		);
		border-radius: var(--nav-shell-condensed-radius);
		overflow-x: auto;
		overflow-y: hidden;
	}

	:global(html[data-nav-condensed]) .site-nav-shell {
		width: 100%;
		padding: 0.38rem 0.52rem 0.38rem 0.58rem;
		gap: 0.58rem;
		transform: translate3d(0, 0, 0) scale(var(--nav-shell-condensed-scale));
	}

	:global(html[data-nav-condensed]) .site-brand-mark {
		width: 1.95rem;
		height: 1.95rem;
		border-radius: 50%;
	}

	:global(html[data-nav-condensed]) .site-brand-copy small {
		opacity: 0;
		max-height: 0;
		transform: translateY(-3px);
	}

	:global(html[data-nav-condensed]) .nav-links {
		background: transparent;
		border-color: transparent;
		padding: 0.1rem;
	}

	:global(html[data-nav-condensed]) .nav-link {
		padding: 0.38rem 0.72rem;
	}

	/* 文章阅读态灵动岛变形：平时折叠为「当前章节 + 进度环」迷你岛，指针移入时无缝展开回完整导航 */
	@media (min-width: 769px) {
		:global(html[data-nav-condensed][data-reading-active="true"])
			.site-nav-shell-scroll:not(:hover):not(:focus-within)
			.site-brand-copy-link,
		:global(html[data-nav-condensed][data-reading-active="true"])
			.site-nav-shell-scroll:not(:hover):not(:focus-within)
			.nav-links {
			display: none;
		}

		:global(html[data-nav-condensed][data-reading-active="true"])
			.site-nav-shell-scroll:not(:hover):not(:focus-within)
			.nav-reading-hud {
			display: inline-flex;
		}
	}

	:global(html[data-nav-condensed][data-reading-active="true"]) .nav-reading-pill {
		opacity: 1;
		transform: scale(1);
		pointer-events: auto;
	}

	:global(html[data-nav-condensed][data-reading-active="true"]) .nav-reading-track {
		opacity: 0.85;
	}

	@media (max-width: 960px) {
		.site-header {
			top: 0;
			padding-inline: 0;
		}

		.site-nav-shell {
			gap: 0.58rem;
			padding:
				0.62rem
				calc(0.9rem + env(safe-area-inset-right))
				0.62rem
				calc(0.9rem + env(safe-area-inset-left));
		}

		.nav-cmd-trigger kbd {
			display: none;
		}

		.nav-cmd-trigger {
			width: 2.05rem;
			height: 2.05rem;
			padding: 0;
			justify-content: center;
		}

		:global(html[data-nav-condensed]) .site-header {
			top: 0.5rem;
			padding-inline: 0.5rem;
		}

		:global(html[data-nav-condensed]) .site-nav::before {
			inset-inline: var(--nav-shell-condensed-inset-mobile);
			border-radius: var(--radius-pill);
			transform: translate3d(0, 0, 0) scale(var(--nav-shell-condensed-scale));
		}

		:global(html[data-nav-condensed]) .site-nav-shell {
			padding: 0.36rem 0.5rem;
			transform: translate3d(0, 0, 0) scale(var(--nav-shell-condensed-scale));
		}

		:global(html[data-nav-condensed]) .site-nav-shell-scroll {
			width: calc(100% - (var(--nav-shell-condensed-inset-mobile) * 2));
			margin-inline: var(--nav-shell-condensed-inset-mobile);
			border-radius: var(--radius-pill);
		}
	}

	@media (max-width: 640px) {
		.site-nav-shell {
			width: 100%;
			min-width: 0;
			gap: 0.32rem;
			padding: 0.52rem 0.65rem;
		}

		.site-brand-copy-link {
			display: none;
		}

		.site-brand-mark {
			width: 1.9rem;
			height: 1.9rem;
			padding: 0.18rem;
		}

		.nav-links {
			gap: 0.04rem;
			padding: 0.14rem;
		}

		.nav-link {
			padding: 0.34rem 0.52rem;
			font-size: 0.8rem;
		}

		.nav-actions {
			gap: 0.25rem;
		}

		.nav-cmd-trigger,
		.nav-actions :global(.theme-toggle) {
			width: 1.9rem;
			height: 1.9rem;
		}

		.nav-reading-pill {
			height: 1.85rem;
