---
interface TaxonomyOption {
	slug: string;
	name: string;
}

interface Props {
	initialQuery?: string;
	categories?: TaxonomyOption[];
	tags?: TaxonomyOption[];
	selectedCategory?: string;
	selectedTags?: string[];
	selectedDateFrom?: string;
	selectedDateTo?: string;
}

const {
	initialQuery = "",
	categories = [],
	tags = [],
	selectedCategory = "",
	selectedTags = [],
	selectedDateFrom = "",
	selectedDateTo = "",
}: Props = Astro.props;

const selectedTagSet = new Set(selectedTags);
const selectedTagItems = tags.filter((tag) => selectedTagSet.has(tag.slug));
const hasDateFilter = Boolean(selectedDateFrom || selectedDateTo);
const selectedDateLabel = hasDateFilter
	? `${selectedDateFrom || "不限"} 至 ${selectedDateTo || "不限"}`
	: "全部范围";
---

<div class="search-container">
	<form class="search-form" action="/search" method="get">
		<div class="search-bar-row">
			<div class="search-input-wrap">
				<svg
					class="search-icon"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
				<input
					type="search"
					name="q"
					class="search-input"
					placeholder="搜索文章标题、摘要或关键词"
					aria-label="搜索文章"
					autocomplete="off"
					value={initialQuery}
				/>
				<kbd class="search-kbd" aria-hidden="true">⌘K</kbd>
			</div>
			{categories.length > 0 ? (
				<select name="category" class="search-select" aria-label="按分类筛选">
					<option value="">全部分类</option>
					{categories.map((category) => (
						<option value={category.slug} selected={selectedCategory === category.slug}>
							{category.name}
						</option>
					))}
				</select>
			) : null}
			<button type="submit" class="button search-button">开始搜索</button>
		</div>

		<div class="search-filters-grid">
			{tags.length > 0 ? (
				<div class="search-tags-shell">
					<div class="search-tags-head">
						<span class="search-tags-head-label">标签筛选</span>
						{selectedTagItems.length > 0 ? (
							<div class="search-selected-tags" aria-live="polite">
								{selectedTagItems.map((tag) => (
									<span class="search-selected-chip">{tag.name}</span>
								))}
							</div>
						) : (
							<span class="search-selected-empty">未选择标签</span>
						)}
					</div>
					<details class="search-tags-panel">
						<summary>
							{selectedTagItems.length > 0
								? `调整标签（已选 ${selectedTagItems.length}）`
								: "展开选择标签"}
						</summary>
						<fieldset class="search-tags">
							<legend class="sr-only">按标签筛选</legend>
							<div class="search-tag-list">
								{tags.map((tag) => (
									<label class="search-tag-chip">
										<input
											type="checkbox"
											name="tags"
											value={tag.slug}
											checked={selectedTagSet.has(tag.slug)}
										/>
										<span>{tag.name}</span>
									</label>
								))}
							</div>
						</fieldset>
					</details>
				</div>
			) : null}

			<div class="search-date-shell">
				<div class="search-date-head">
					<span class="search-date-head-label">时间范围</span>
					<span class="search-date-hint">{selectedDateLabel}</span>
				</div>
				<details class="search-date-panel">
					<summary>
						{hasDateFilter ? "调整时间范围（已设置）" : "展开选择时间范围"}
					</summary>
					<div class="search-date-body">
						<p class="search-date-tip">起止日期都可留空；不填即按全部范围搜索。</p>
						<div class="search-date-row">
							<label class="search-date-field">
								<span>从</span>
								<input
									type="date"
									name="dateFrom"
									class="search-date-input"
									aria-label="起始日期"
									value={selectedDateFrom}
								/>
							</label>
							<label class="search-date-field">
								<span>到</span>
								<input
									type="date"
									name="dateTo"
									class="search-date-input"
									aria-label="结束日期"
									value={selectedDateTo}
								/>
							</label>
						</div>
					</div>
				</details>
			</div>
		</div>
	</form>
	<div id="search-results" class="search-results"></div>
</div>

<style>
	.search-container {
		width: 100%;
	}

	.search-form {
		display: grid;
		gap: 0.9rem;
	}

	.search-bar-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		padding: 0.42rem;
		border-radius: var(--radius-card);
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border-strong);
		box-shadow: inset 0 1px 0 var(--glass-highlight);
	}

	.search-input-wrap {
		flex: 1 1 16rem;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding-inline: 0.75rem 0.5rem;
	}

	.search-kbd {
		flex-shrink: 0;
		padding: 0.16rem 0.42rem;
		border-radius: 6px;
		border: 1px solid var(--color-border);
		background: var(--color-bg-secondary);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		line-height: 1.2;
		user-select: none;
	}

	@media (max-width: 640px) {
		.search-kbd {
			display: none;
		}
	}

	.search-icon {
		flex-shrink: 0;
		color: var(--color-text-muted);
	}

	.search-input,
	.search-select,
	.search-date-input {
		padding: 0.65rem 0.85rem;
		border: 1px solid transparent;
		border-radius: var(--radius-inner);
		background-color: transparent;
		color: var(--color-text);
		font-size: 0.94rem;
		font-family: var(--font-sans);
		transition:
			border-color var(--transition),
			background-color var(--transition);
	}

	.search-input {
		width: 100%;
		padding-left: 0.1rem;
	}

	.search-select {
		flex: 0 0 auto;
		min-width: 8.5rem;
		border-color: var(--color-border);
		background-color: var(--color-bg-secondary);
		cursor: pointer;
	}

	.search-input::placeholder {
		color: var(--color-text-placeholder);
	}

	.search-input:focus,
	.search-select:focus,
	.search-date-input:focus {
		outline: none;
	}

	.search-bar-row:focus-within {
		border-color: rgba(var(--color-accent-rgb), 0.45);
	}

	.search-date-input {
		width: 100%;
		border-color: var(--color-border);
		background: var(--color-bg-secondary);
		font-family: var(--font-mono);
		font-size: 0.84rem;
	}

	.search-date-input:focus {
		border-color: rgba(var(--color-accent-rgb), 0.45);
	}

	.search-button {
		padding: 0.68rem 1.2rem;
	}

	.search-filters-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 0.75rem;
		align-items: start;
	}

	.search-tags-shell,
	.search-date-shell {
		display: grid;
		gap: 0.42rem;
	}

	.search-tags-head,
	.search-date-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.search-tags-head-label,
	.search-date-head-label {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.search-selected-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		justify-content: flex-end;
	}

	.search-selected-chip {
		padding: 0.16rem 0.52rem;
		border-radius: var(--radius-pill);
		border: 1px solid rgba(var(--color-accent-rgb), 0.35);
		background: var(--color-accent-soft);
		font-size: 0.74rem;
		color: var(--color-accent);
	}

	.search-selected-empty,
	.search-date-hint {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.search-tags-panel,
	.search-date-panel {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-inner);
		background: var(--color-bg-tertiary);
		overflow: hidden;
	}

	.search-tags-panel summary,
	.search-date-panel summary {
		list-style: none;
		cursor: pointer;
		padding: 0.58rem 0.82rem;
		font-size: 0.82rem;
		color: var(--color-text-secondary);
		display: flex;
		align-items: center;
		justify-content: space-between;
		user-select: none;
	}

	.search-tags-panel summary::-webkit-details-marker,
	.search-date-panel summary::-webkit-details-marker {
		display: none;
	}

	.search-tags-panel summary::after,
	.search-date-panel summary::after {
		content: "▾";
		font-size: 0.75rem;
		opacity: 0.75;
		transition: transform var(--transition);
	}

	.search-tags-panel[open] summary::after,
	.search-date-panel[open] summary::after {
		transform: rotate(180deg);
	}

	.search-tags-panel[open] summary,
	.search-date-panel[open] summary {
		border-bottom: 1px solid var(--color-border);
	}

	.search-tags,
	.search-date-body {
		border: none;
		padding: 0.68rem 0.82rem 0.82rem;
		margin: 0;
		display: grid;
		gap: 0.55rem;
	}

	.search-date-tip {
		margin: 0;
		font-size: 0.76rem;
		color: var(--color-text-muted);
	}

	.search-date-row {
		display: flex;
		gap: 0.65rem;
		flex-wrap: wrap;
	}

	.search-date-field {
		display: grid;
		gap: 0.3rem;
		flex: 1;
		min-width: min(100%, 9.5rem);
		font-size: 0.76rem;
		color: var(--color-text-muted);
	}

	.search-tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.42rem;
	}

	.search-tag-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.32rem;
		padding: 0.3rem 0.58rem;
		border-radius: var(--radius-pill);
		border: 1px solid var(--color-border);
		background: var(--color-bg-secondary);
		font-size: 0.78rem;
		color: var(--color-text-secondary);
		cursor: pointer;
		transition:
			border-color var(--transition),
			color var(--transition);
	}

	.search-tag-chip:has(input:checked) {
		border-color: rgba(var(--color-accent-rgb), 0.4);
		background: var(--color-accent-soft);
		color: var(--color-accent);
	}

	.search-tag-chip input {
		margin: 0;
		accent-color: var(--color-accent);
	}

	.search-results {
		margin-top: var(--space-md);
	}

	@media (max-width: 640px) {
		.search-bar-row {
			flex-direction: column;
			align-items: stretch;
		}

		.search-select,
		.search-button {
			width: 100%;
		}
	}
</style>
