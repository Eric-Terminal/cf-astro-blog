---
import { siteConfig } from "@/lib/types";

const commentsConfig = siteConfig.comments;
const isCommentConfigReady = Boolean(
	commentsConfig.repo &&
		commentsConfig.repoId &&
		commentsConfig.category &&
		commentsConfig.categoryId,
);
---

<section
	class="comments-panel"
	data-comments-panel
	data-comments-ready={isCommentConfigReady ? "true" : "false"}
	data-comments-provider={commentsConfig.provider}
	data-comments-repo={commentsConfig.repo}
	data-comments-repo-id={commentsConfig.repoId}
	data-comments-category={commentsConfig.category}
	data-comments-category-id={commentsConfig.categoryId}
	data-comments-mapping={commentsConfig.mapping}
	data-comments-strict={commentsConfig.strict ? "1" : "0"}
	data-comments-reactions-enabled={commentsConfig.reactionsEnabled ? "1" : "0"}
	data-comments-input-position={commentsConfig.inputPosition}
	data-comments-lang={commentsConfig.lang}
>
	<button
		class="comments-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="comments-panel-body"
		data-comments-toggle
	>
		<span class="comments-toggle-copy">
			<strong>文章讨论区</strong>
			<small>展开后按需加载 GitHub Discussions</small>
		</span>
		<span class="comments-toggle-icon" aria-hidden="true">+</span>
	</button>

	<div
		id="comments-panel-body"
		class="comments-body"
		hidden
		data-comments-body
	>
		{isCommentConfigReady ? (
			<div class="comments-surface">
				<div class="comments-note">
					<p>评论由 GitHub Discussions 承载</p>
				</div>
				<div class="comments-host" data-giscus-host></div>
			</div>
		) : (
			<div class="comments-empty-state">
				<p>评论组件已就绪，请在 GitHub 仓库开启 Discussions 并补齐分类 ID。</p>
				<p>当前仓库：{commentsConfig.repo}</p>
			</div>
		)}
	</div>
</section>

<script is:inline src="/comments.js"></script>

<style>
	.comments-panel {
		display: grid;
		gap: 0;
		overflow: hidden;
		border-radius: var(--radius-inner);
		border: 1px solid var(--color-border);
		background: var(--color-bg-tertiary);
	}

	.comments-toggle {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		width: 100%;
		padding: 1.05rem 1.35rem;
		border: none;
		background: transparent;
		color: inherit;
		cursor: pointer;
		text-align: left;
		border-bottom: 1px solid transparent;
		transition:
			background-color var(--transition),
			border-color var(--transition);
	}

	.comments-toggle:hover,
	.comments-toggle:focus-visible {
		background: var(--color-bg-tertiary);
		outline: none;
	}

	.comments-toggle-copy {
		display: grid;
		gap: 0.18rem;
	}

	.comments-toggle-copy strong {
		font-size: 0.96rem;
		font-weight: 680;
		color: var(--color-text);
	}

	.comments-toggle-copy small {
		font-size: 0.84rem;
		color: var(--color-text-muted);
		line-height: 1.6;
	}

	.comments-toggle-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: var(--radius-pill);
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
		font-size: 1.15rem;
		color: var(--color-text-secondary);
		transition:
			transform var(--transition),
			background-color var(--transition),
			border-color var(--transition),
			color var(--transition);
	}

	.comments-toggle:hover .comments-toggle-icon {
		color: var(--color-accent);
		border-color: rgba(var(--color-accent-rgb), 0.3);
		background: var(--color-accent-soft);
	}

	.comments-panel.is-open .comments-toggle-icon {
		transform: rotate(45deg);
	}

	.comments-panel.is-open .comments-toggle {
		border-bottom-color: var(--color-border);
	}

	.comments-body {
		padding: 1rem 1.35rem 1.35rem;
	}

	.comments-surface,
	.comments-empty-state {
		display: grid;
		gap: 0.8rem;
		padding: 1rem;
		border-radius: var(--radius-inner);
		background: var(--color-bg-tertiary);
		border: 1px solid var(--color-border);
	}

	.comments-note,
	.comments-empty-state {
		font-size: 0.86rem;
		color: var(--color-text-muted);
		line-height: 1.7;
	}

	.comments-host {
		min-height: 8rem;
	}

	:global(html.article-opaque-mode) .comments-panel {
		background: rgba(var(--card-surface-rgb), 0.94);
		border-color: var(--color-border-strong);
	}

	:global(html.article-opaque-mode) .comments-surface,
	:global(html.article-opaque-mode) .comments-empty-state {
		background: rgba(var(--card-surface-rgb), 0.98);
		border-color: var(--color-border-strong);
	}

	@media (max-width: 640px) {
		.comments-toggle,
		.comments-body {
			padding-inline: 1rem;
		}
	}
</style>
